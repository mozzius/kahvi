+        };
+        // c. Append _byte_ to _bytes_.
+        bytes.push(byte as u8);
+        // d. Set _index_ to _index_ + 1.
+    }
+    //    8. Return _bytes_.
+
     // 4. Let _out_ be the empty String.
+    let mut out: Vec<u16> = Vec::with_capacity(len * 2);
     // 5. For each byte _byte_ of _toEncode_, do
