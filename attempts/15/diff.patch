--- a/crates/kahvi-builtins/src/array/prototype_index_of.rs
+++ b/crates/kahvi-builtins/src/array/prototype_index_of.rs
@@ -9,7 +9,7 @@ pub(crate) fn prototype_index_of(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
     // This method compares _searchElement_ to the elements of the array, in ascending order, using the IsStrictlyEqual algorithm, and if found at one or more indices, returns the smallest such index; otherwise, it returns *-1*_𝔽.
     // NOTE:
@@ -17,20 +17,53 @@ pub(crate) fn prototype_index_of(
     // This method performs the following steps when called:
     //
     // 1. Let _obj_ be ? ToObject(*this* value).
+    let obj = ops::to_object(agent, this)?;
     // 2. Let _length_ be ? LengthOfArrayLike(_obj_).
+    let length = ops::length_of_array_like(agent, obj)?;
     // 3. If _length_ = 0, return *-1*_𝔽.
+    if length == 0.0 {
+        return Ok(Value::Number(-1.0));
+    }
     // 4. Let _k_ be ? ToClampedIndex(_fromIndex_, _length_).
+    let mut k = to_clamped_index(agent, args.get_or_undefined(1), length)?;
     // 5. Repeat, while _k_ < _length_,
-    //    a. Let _propertyKey_ be ! ToString(𝔽(_k_)).
-    //    b. Let _kPresent_ be ? HasProperty(_obj_, _propertyKey_).
-    //    c. If _kPresent_ is *true*, then
-    //       i. Let _elementK_ be ? Get(_obj_, _propertyKey_).
-    //       ii. If IsStrictlyEqual(_searchElement_, _elementK_) is *true*, return 𝔽(_k_).
-    //    d. Set _k_ to _k_ + 1.
+    while k < length {
+        // a. Let _propertyKey_ be ! ToString(𝔽(_k_)).
+        let property_key = agent.key_from_index(k);
+        // b. Let _kPresent_ be ? HasProperty(_obj_, _propertyKey_).
+        let k_present = ops::has_property(agent, obj, property_key)?;
+        // c. If _kPresent_ is *true*, then
+        if k_present {
+            // i. Let _elementK_ be ? Get(_obj_, _propertyKey_).
+            let element_k = ops::get(agent, obj, property_key)?;
+            // ii. If IsStrictlyEqual(_searchElement_, _elementK_) is *true*, return 𝔽(_k_).
+            if ops::is_strictly_equal(agent, args.get_or_undefined(0), element_k) {
+                return Ok(Value::Number(k));
+            }
+        }
+        // d. Set _k_ to _k_ + 1.
+        k += 1.0;
+    }
     // 6. Return *-1*_𝔽.
-    //
-    // NOTE:
-    // This method is intentionally generic; it does not require that its *this* value be an Array. Therefore it can be transferred to other kinds of objects for use as a method.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Array.prototype.indexOf"))
+    Ok(Value::Number(-1.0))
+}
+
+/// ToClampedIndex ( _value_, _length_ ), which is not yet in `kahvi_core::ops`.
+fn to_clamped_index(agent: &mut Agent, value: Value, length: f64) -> JsResult<f64> {
+    // 1. Let _index_ be ? ToAbsoluteIndex(_value_, _length_).
+    // ToAbsoluteIndex ( _relative_, _length_ ) is inlined here:
+    // 1. Let relativeIndex be ? ToIntegerOrInfinity(relative).
+    let relative_index = ops::to_integer_or_infinity(agent, value)?;
+    // 2. If relativeIndex = -∞, return +0𝔽.
+    // 3. If relativeIndex < 0, return max(length + relativeIndex, 0).
+    // 4. Return min(relativeIndex, length).
+    let index = if relative_index == f64::NEG_INFINITY {
+        0.0
+    } else if relative_index < 0.0 {
+        (length + relative_index).max(0.0)
+    } else {
+        relative_index.min(length)
+    };
+    // 2. Return the result of clamping _index_ between 0 and _length_.
+    Ok(index.clamp(0.0, length))
 }
