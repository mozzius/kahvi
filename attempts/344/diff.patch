diff --git a/crates/kahvi-builtins/src/math/sqrt.rs b/crates/kahvi-builtins/src/math/sqrt.rs
index 564c926..771548c 100644
--- a/crates/kahvi-builtins/src/math/sqrt.rs
+++ b/crates/kahvi-builtins/src/math/sqrt.rs
@@ -18,6 +18,18 @@ pub(crate) fn sqrt(
     // 2. If _n_ is one of *NaN*, *+0*_𝔽, *-0*_𝔽, or *+∞*_𝔽, return _n_.
     // 3. If _n_ < *-0*_𝔽, return *NaN*.
     // 4. Return 𝔽(the square root of ℝ(_n_)).
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Math.sqrt"))
+    let _ = (this, new_target);
+    let x = args.get_or_undefined(0);
+    // 1. Let _n_ be ? ToNumber(_x_).
+    let n = ops::to_number(agent, x)?;
+    // 2. If _n_ is one of *NaN*, *+0*_𝔽, *-0*_𝔽, or *+∞*_𝔽, return _n_.
+    if n.is_nan() || n == 0.0 || n == f64::INFINITY {
+        return Ok(Value::Number(n));
+    }
+    // 3. If _n_ < *-0*_𝔽, return *NaN*.
+    if n < 0.0 {
+        return Ok(Value::Number(f64::NAN));
+    }
+    // 4. Return 𝔽(the square root of ℝ(_n_)).
+    Ok(Value::Number(n.sqrt()))
 }
