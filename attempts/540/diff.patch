diff --git a/crates/kahvi-builtins/src/iterator/prototype_chunks.rs b/crates/kahvi-builtins/src/iterator/prototype_chunks.rs
index 79dc6e9..3d20a72 100644
--- a/crates/kahvi-builtins/src/iterator/prototype_chunks.rs
+++ b/crates/kahvi-builtins/src/iterator/prototype_chunks.rs
@@ -4,41 +4,130 @@
 
 use kahvi_core::prelude::*;
 
+use kahvi_core::ops::IteratorRecord;
+
+use crate::support::iterator_helper::{HelperClosure, create_iterator_helper, iterator_close_all};
+
 /// Iterator.prototype.chunks
 pub(crate) fn prototype_chunks(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _O_ be the *this* value.
-    // 2. If _O_ is not an Object, throw a *TypeError* exception.
-    // 3. Let _iterated_ be the Iterator Record { [[Iterator]]: _O_, [[NextMethod]]: *undefined*, [[Done]]: *false* }.
-    // 4. If _chunkSize_ is not an integral Number, then
-    //    a. Let _error_ be ThrowCompletion(a newly created *TypeError* object).
-    //    b. Return ? IteratorClose(_iterated_, _error_).
-    // 5. If _chunkSize_ is not in the inclusive interval from *1*_𝔽 to 𝔽(2^32 - 1), then
-    //    a. Let _error_ be ThrowCompletion(a newly created *RangeError* object).
-    //    b. Return ? IteratorClose(_iterated_, _error_).
-    // 6. Set _iterated_ to ? GetIteratorDirect(_O_).
-    // 7. Let _closure_ be a new Abstract Closure with no parameters that captures _iterated_ and _chunkSize_ and performs the following steps when called:
-    //    a. Let _buffer_ be a new empty List.
-    //    b. Repeat,
-    //       i. Let _value_ be ? IteratorStepValue(_iterated_).
-    //       ii. If _value_ is ~done~, then
-    //          1. If _buffer_ is not empty, then
-    //             a. Perform Completion(Yield(CreateArrayFromList(_buffer_))).
-    //          2. Return ReturnCompletion(*undefined*).
-    //       iii. Append _value_ to _buffer_.
-    //       iv. If the number of elements in _buffer_ is ℝ(_chunkSize_), then
-    //          1. Let _completion_ be Completion(Yield(CreateArrayFromList(_buffer_))).
-    //          2. IfAbruptCloseIterator(_completion_, _iterated_).
-    //          3. Set _buffer_ to a new empty List.
-    // 8. Let _result_ be CreateIteratorFromClosure(_closure_, *"Iterator Helper"*, %IteratorHelperPrototype%, « [[UnderlyingIterators]] »).
-    // 9. Set _result_.[[UnderlyingIterators]] to « _iterated_ ».
-    // 10. Return _result_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Iterator.prototype.chunks"))
+    let chunk_size = args.get_or_undefined(0);
+    // 1. Let O be the this value.
+    // 2. If O is not an Object, throw a TypeError exception.
+    let Value::Object(o) = this else {
+        return Err(agent.throw_type_error("Iterator.prototype.chunks called on a non-object"));
+    };
+    // 3. Let iterated be the Iterator Record { [[Iterator]]: O, [[NextMethod]]: undefined, [[Done]]: false }.
+    let iterated = IteratorRecord {
+        iterator: o,
+        next_method: Value::Undefined,
+        done: false,
+    };
+    // 4. If chunkSize is not an integral Number, then
+    let chunk_size = match chunk_size {
+        Value::Number(n) if ops::is_integral_number(chunk_size) => n,
+        _ => {
+            // a. Let error be ThrowCompletion(a newly created TypeError object).
+            let error =
+                agent.throw_type_error("Iterator.prototype.chunks: chunkSize is not an integer");
+            // b. Return ? IteratorClose(iterated, error).
+            return ops::iterator_close(agent, &iterated, Err(error));
+        }
+    };
+    // 5. If chunkSize is not in the inclusive interval from 1𝔽 to 𝔽(2^32 - 1), then
+    if !(1.0..=4294967295.0).contains(&chunk_size) {
+        // a. Let error be ThrowCompletion(a newly created RangeError object).
+        let error = agent.throw_range_error("Iterator.prototype.chunks: chunkSize is out of range");
+        // b. Return ? IteratorClose(iterated, error).
+        return ops::iterator_close(agent, &iterated, Err(error));
+    }
+    // 6. Set iterated to ? GetIteratorDirect(O).
+    let iterated = ops::get_iterator_direct(agent, o)?;
+    // 7. Let closure be a new Abstract Closure with no parameters that captures iterated and chunkSize
+    //    and performs the following steps when called:
+    let closure = ChunksClosure {
+        chunk_size,
+        buffer: Vec::new(),
+        flushed: false,
+    };
+    // 8-10. Let result be CreateIteratorFromClosure(closure, "Iterator Helper", %IteratorHelperPrototype%,
+    //       « [[UnderlyingIterators]] »), with [[UnderlyingIterators]] « iterated ». Return result.
+    Ok(Value::Object(create_iterator_helper(
+        agent,
+        Box::new(closure),
+        vec![iterated],
+    )))
+}
+
+/// Step 7's closure: captures iterated and chunkSize.
+#[derive(Debug)]
+struct ChunksClosure {
+    /// The captured chunkSize.
+    chunk_size: f64,
+    /// a. Let buffer be a new empty List. (Updated by steps b.iii and b.iv.3.)
+    buffer: Vec<Value>,
+    /// Set once the final partial chunk has been yielded (step b.ii.1.a); the
+    /// Yield there is not wrapped in IfAbruptCloseIterator, and the closure
+    /// returns after it.
+    flushed: bool,
+}
+
+impl HelperClosure for ChunksClosure {
+    // b. Repeat,
+    fn resume(
+        &mut self,
+        agent: &mut Agent,
+        underlying: &mut [IteratorRecord],
+    ) -> JsResult<Option<Value>> {
+        // Resumed after the final Yield: step b.ii.2 returns undefined.
+        if self.flushed {
+            return Ok(None);
+        }
+        let iterated = &mut underlying[0];
+        loop {
+            // i. Let value be ? IteratorStepValue(iterated).
+            let Some(value) = ops::iterator_step_value(agent, iterated)? else {
+                // ii. If value is done, then
+                // 1. If buffer is not empty, then
+                if !self.buffer.is_empty() {
+                    // a. Perform Completion(Yield(CreateArrayFromList(buffer))).
+                    let array =
+                        ops::create_array_from_list(agent, &std::mem::take(&mut self.buffer));
+                    self.flushed = true;
+                    return Ok(Some(Value::Object(array)));
+                }
+                // 2. Return ReturnCompletion(undefined).
+                return Ok(None);
+            };
+            // iii. Append value to buffer.
+            self.buffer.push(value);
+            // iv. If the number of elements in buffer is ℝ(chunkSize), then
+            if self.buffer.len() as f64 == self.chunk_size {
+                // 1. Let completion be Completion(Yield(CreateArrayFromList(buffer))).
+                // 2. IfAbruptCloseIterator(completion, iterated): HelperClosure::on_return.
+                // 3. Set buffer to a new empty List.
+                let array = ops::create_array_from_list(agent, &std::mem::take(&mut self.buffer));
+                return Ok(Some(Value::Object(array)));
+            }
+        }
+    }
+
+    // A return completion at the final flush's Yield is discarded by step b.ii.1.a,
+    // so the (already exhausted) underlying iterator is not closed.
+    fn on_return(&mut self, agent: &mut Agent, underlying: &mut [IteratorRecord]) -> JsResult<()> {
+        if self.flushed {
+            return Ok(());
+        }
+        iterator_close_all(agent, underlying, Ok(()))
+    }
+}
+
+impl kahvi_core::gc::Trace for ChunksClosure {
+    fn trace(&self, t: &mut kahvi_core::gc::Tracer) {
+        self.buffer.trace(t);
+    }
 }
