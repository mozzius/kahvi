 //!
 //! Spec: https://tc39.es/ecma262/#sec-date.prototype.tolocaledatestring
 
+use crate::support::date;
 use kahvi_core::prelude::*;
 
 /// Date.prototype.toLocaleDateString
 pub(crate) fn prototype_to_locale_date_string(
     agent: &mut Agent,
     this: Value,
-    args: &[Value],
-    new_target: Option<Object>,
+    _args: &[Value],
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
     // An ECMAScript implementation that includes the ECMA-402 Internationalization API must implement this method as specified in ECMA-402. Otherwise, the following specification of this method is used:
     // This method returns a String value. The contents of the String are implementation-defined, but are intended to represent the “date” portion of the Date in the current time zone in a convenient, human-readable form that corresponds to the conventions of the host environment's current locale.
     // The meaning of the optional parameters to this method are defined in ECMA-402; implementations that do not include ECMA-402 support must not use those parameter positions for anything else.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Date.prototype.toLocaleDateString"))
+    //
+    // This engine does not include ECMA-402, so the optional parameters are ignored and the
+    // date portion is formatted in the en-US numeric convention, M/D/YYYY.
+
+    // 1. Let dateObj be the this value.
+    // 2. Perform ? RequireInternalSlot(dateObj, [[DateValue]]).
+    //    (thisTimeValue performs the RequireInternalSlot check: it throws a TypeError
+    //    unless dateObj is an Object with a [[DateValue]] internal slot.)
+    // 3. Let tv be dateObj.[[DateValue]].
+    let tv = date::this_time_value(agent, this)?;
+    // 4. If tv is NaN, return "Invalid Date".
+    if tv.is_nan() {
+        return Ok(Value::String(agent.string("Invalid Date")));
+    }
+    // 5. Let t be LocalTime(tv).
+    let t = date::local_time(agent, tv);
+    // 6. Return the date portion of t, formatted as month/day/year.
+    let month = date::month_from_time(t) as i64 + 1;
+    let day = date::date_from_time(t) as i64;
+    let yv = date::year_from_time(t);
+    let year_sign = if yv < 0.0 { "-" } else { "" };
+    let year = yv.abs() as i64;
+    let s = format!("{month}/{day}/{year_sign}{year}");
+    Ok(Value::String(agent.string(&s)))
 }
