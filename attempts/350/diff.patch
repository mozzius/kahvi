diff --git a/crates/kahvi-builtins/src/reflect/get_prototype_of.rs b/crates/kahvi-builtins/src/reflect/get_prototype_of.rs
index 5c82415..69e0512 100644
--- a/crates/kahvi-builtins/src/reflect/get_prototype_of.rs
+++ b/crates/kahvi-builtins/src/reflect/get_prototype_of.rs
@@ -15,6 +15,15 @@ pub(crate) fn get_prototype_of(
     //
     // 1. If _target_ is not an Object, throw a *TypeError* exception.
     // 2. Return ? _target_.[[GetPrototypeOf]]().
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Reflect.getPrototypeOf"))
+    let _ = (this, new_target);
+    // 1. If _target_ is not an Object, throw a *TypeError* exception.
+    let Value::Object(target) = args.get_or_undefined(0) else {
+        return Err(agent.throw_type_error("Reflect.getPrototypeOf called on non-object"));
+    };
+    // 2. Return ? _target_.[[GetPrototypeOf]]().
+    let proto = target.internal_get_prototype_of(agent)?;
+    Ok(match proto {
+        Some(p) => Value::Object(p),
+        None => Value::Null,
+    })
 }
