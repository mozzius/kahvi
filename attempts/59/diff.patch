diff --git a/crates/kahvi-builtins/src/array/prototype_to_string.rs b/crates/kahvi-builtins/src/array/prototype_to_string.rs
index 4297a14..75b1bab 100644
--- a/crates/kahvi-builtins/src/array/prototype_to_string.rs
+++ b/crates/kahvi-builtins/src/array/prototype_to_string.rs
@@ -8,8 +8,8 @@ use kahvi_core::prelude::*;
 pub(crate) fn prototype_to_string(
     agent: &mut Agent,
     this: Value,
-    args: &[Value],
-    new_target: Option<Object>,
+    _args: &[Value],
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
     // This method performs the following steps when called:
     //
@@ -20,6 +20,15 @@ pub(crate) fn prototype_to_string(
     //
     // NOTE:
     // This method is intentionally generic; it does not require that its *this* value be an Array. Therefore it can be transferred to other kinds of objects for use as a method.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Array.prototype.toString"))
+    // 1. Let _array_ be ? ToObject(*this* value).
+    let array = ops::to_object(agent, this)?;
+    // 2. Let _func_ be ? Get(_array_, *"join"*).
+    let join = agent.key("join");
+    let mut func = ops::get(agent, array, join)?;
+    // 3. If IsCallable(_func_) is *false*, set _func_ to the intrinsic function %Object.prototype.toString%.
+    if !ops::is_callable(agent, func) {
+        func = Value::Object(agent.intrinsic("%Object.prototype.toString%"));
+    }
+    // 4. Return ? Call(_func_, _array_).
+    ops::call(agent, func, Value::Object(array), &[])
 }
