 //!
 //! Spec: https://tc39.es/ecma262/#sec-iterator.prototype.some
 
+use kahvi_core::ops::IteratorRecord;
 use kahvi_core::prelude::*;
 
+use crate::support::iterator_helper::if_abrupt_close_iterator;
