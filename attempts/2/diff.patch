+/// IsConcatSpreadable ( _obj_ )
+///
+/// Spec: https://tc39.es/ecma262/#sec-isconcatspreadable
+fn is_concat_spreadable(agent: &mut Agent, obj: Value) -> JsResult<bool> {
+    // 1. If _obj_ is not an Object, return *false*.
+    let Value::Object(o) = obj else {
+        return Ok(false);
+    };
+    // 2. Let _spreadable_ be ? Get(_obj_, %Symbol.isConcatSpreadable%).
+    let key = PropertyKey::Symbol(agent.symbols_wk.is_concat_spreadable);
+    let spreadable = ops::get(agent, o, key)?;
+    // 3. If _spreadable_ is not *undefined*, return ToBoolean(_spreadable_).
+    if !matches!(spreadable, Value::Undefined) {
+        return Ok(ops::to_boolean(agent, spreadable));
+    }
+    // 4. Return ? IsArray(_obj_).
+    ops::is_array(agent, obj)
 }
