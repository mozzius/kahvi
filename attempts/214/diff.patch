diff --git a/crates/kahvi-builtins/src/string/prototype_starts_with.rs b/crates/kahvi-builtins/src/string/prototype_starts_with.rs
index 3ed425f..2be7928 100644
--- a/crates/kahvi-builtins/src/string/prototype_starts_with.rs
+++ b/crates/kahvi-builtins/src/string/prototype_starts_with.rs
@@ -9,31 +9,56 @@ pub(crate) fn prototype_starts_with(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
     // 1. Let _thisValue_ be the *this* value.
+    let this_value = this;
     // 2. Perform ? RequireObjectCoercible(_thisValue_).
+    ops::require_object_coercible(agent, this_value)?;
     // 3. Let _string_ be ? ToString(_thisValue_).
-    // 4. Let _isRegexp_ be ? IsRegExp(_searchString_).
-    // 5. If _isRegexp_ is *true*, throw a *TypeError* exception.
-    // 6. Set _searchString_ to ? ToString(_searchString_).
-    // 7. Let _length_ be the length of _string_.
-    // 8. Let _start_ be the result of clamping ? ToIntegerOrInfinity(_position_) between 0 and _length_.
-    // 9. Assert: If _position_ is *undefined*, then _start_ is 0.
-    // 10. Let _searchLength_ be the length of _searchString_.
-    // 11. If _searchLength_ = 0, return *true*.
-    // 12. Let _end_ be _start_ + _searchLength_.
-    // 13. If _end_ > _length_, return *false*.
-    // 14. Let _substring_ be the substring of _string_ from _start_ to _end_.
-    // 15. If _substring_ is _searchString_, return *true*.
-    // 16. Return *false*.
-    //
-    // NOTE:
-    // Throwing an exception if the first argument is a RegExp is specified in order to allow future editions to define extensions that allow such argument values.
-    // NOTE:
-    // This method is intentionally generic; it does not require that its *this* value be a String object. Therefore, it can be transferred to other kinds of objects for use as a method.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("String.prototype.startsWith"))
+    let string = ops::to_string(agent, this_value)?;
+    let search_string_arg = args.get_or_undefined(0);
+    let position = args.get_or_undefined(1);
+    // The conversions below may call user code and collect garbage: _string_ stays rooted from here on,
+    // and _searchString_ is rooted once it exists.
+    agent.with_roots(&[Value::String(string)], |agent| {
+        // 4. Let _isRegexp_ be ? IsRegExp(_searchString_).
+        let is_regexp = ops::is_regexp(agent, search_string_arg)?;
+        // 5. If _isRegexp_ is *true*, throw a *TypeError* exception.
+        if is_regexp {
+            return Err(agent.throw_type_error(
+                "First argument to String.prototype.startsWith must not be a regular expression",
+            ));
+        }
+        // 6. Set _searchString_ to ? ToString(_searchString_).
+        let search_string = ops::to_string(agent, search_string_arg)?;
+        agent.with_roots(&[Value::String(search_string)], |agent| {
+            // 7. Let _length_ be the length of _string_.
+            let length = agent.str_len(string) as f64;
+            // 8. Let _start_ be the result of clamping ? ToIntegerOrInfinity(_position_) between 0 and _length_.
+            let position_integer = ops::to_integer_or_infinity(agent, position)?;
+            let start = position_integer.max(0.0).min(length);
+            // 9. Assert: If _position_ is *undefined*, then _start_ is 0.
+            // 10. Let _searchLength_ be the length of _searchString_.
+            let search_length = agent.str_len(search_string) as f64;
+            // 11. If _searchLength_ = 0, return *true*.
+            if search_length == 0.0 {
+                return Ok(Value::Boolean(true));
+            }
+            // 12. Let _end_ be _start_ + _searchLength_.
+            let end = start + search_length;
+            // 13. If _end_ > _length_, return *false*.
+            if end > length {
+                return Ok(Value::Boolean(false));
+            }
+            // 14. Let _substring_ be the substring of _string_ from _start_ to _end_.
+            let substring = &agent.str(string)[start as usize..end as usize];
+            // 15. If _substring_ is _searchString_, return *true*.
+            if substring == agent.str(search_string) {
+                return Ok(Value::Boolean(true));
+            }
+            // 16. Return *false*.
+            Ok(Value::Boolean(false))
+        })
+    })
 }
