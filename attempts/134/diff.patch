@@ -2,25 +2,116 @@
 //!
 //! Spec: https://tc39.es/ecma262/#sec-%typedarray%.prototype.findindex
 
+use kahvi_core::object::typed_array::typed_array_length;
 use kahvi_core::prelude::*;
 
+use crate::support::typed_array::validate_typed_array;
+
 /// TypedArray.prototype.findIndex
 pub(crate) fn prototype_find_index(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
     // The interpretation and use of the arguments of this method are the same as for `Array.prototype.findIndex` as defined in [sec-array.prototype.findindex].
     // This method performs the following steps when called:
     //
     // 1. Let _obj_ be the *this* value.
+    let obj = this;
     // 2. Let _taRecord_ be ? ValidateTypedArray(_obj_, ~seq-cst~).
+    let ta_record = validate_typed_array(agent, obj)?;
+    let Value::Object(obj) = obj else {
+        unreachable!("ValidateTypedArray accepted a non-object")
+    };
     // 3. Let _length_ be TypedArrayLength(_taRecord_).
+    let length = typed_array_length(agent, ta_record) as f64;
     // 4. Let _findRecord_ be ? FindViaPredicate(_obj_, _length_, ~ascending~, _predicate_, _thisArg_).
+    let find_record = find_via_predicate(
+        agent,
+        obj,
+        length,
+        Direction::Ascending,
+        args.get_or_undefined(0),
+        args.get_or_undefined(1),
+    )?;
     // 5. Return _findRecord_.[[Index]].
-    //
-    // This method is not generic. The *this* value must be an object with a [[TypedArrayName]] internal slot.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("TypedArray.prototype.findIndex"))
+    Ok(Value::Number(find_record.index))
+}
+
+/// The direction of a FindViaPredicate search.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Direction {
+    Ascending,
+    #[allow(dead_code)] // for the findLast and findLastIndex tickets
+    Descending,
+}
+
+/// The [[Index]] and [[Value]] fields of a FindViaPredicate Record.
+struct FindRecord {
+    index: f64,
+    #[allow(dead_code)] // read by the find and findLast tickets
+    value: Value,
+}
+
+/// FindViaPredicate(O, len, direction, predicate, thisArg) (§23.1.3.12.1)
+fn find_via_predicate(
+    agent: &mut Agent,
+    o: Object,
+    len: f64,
+    direction: Direction,
+    predicate: Value,
+    this_arg: Value,
+) -> JsResult<FindRecord> {
+    // 1. If IsCallable(predicate) is false, throw a TypeError exception.
+    if !ops::is_callable(agent, predicate) {
+        return Err(
+            agent.throw_type_error("TypedArray.prototype.findIndex predicate is not a function")
+        );
+    }
+    // The predicate may collect garbage: O, predicate and thisArg stay rooted.
+    agent.with_roots(&[Value::Object(o), predicate, this_arg], |agent| {
+        // 2. If direction is ascending, let indices be a List whose elements are integers
+        //    from 0 to len - 1, in ascending order. Otherwise, let indices be a List whose
+        //    elements are integers from 0 to len - 1, in descending order.
+        // 3. For each integer k of indices, do
+        let mut position = 0.0;
+        while position < len {
+            let k = match direction {
+                Direction::Ascending => position,
+                Direction::Descending => len - 1.0 - position,
+            };
+            // (position counts the visited indices, so k walks `indices` in order.)
+            // a. Let Pk be ! ToString(𝔽(k)).
+            let pk = agent.key_from_index(k);
+            // b. NOTE: If O is a TypedArray, the following invocation of Get will return a Number value
+            //    or a BigInt value, possibly undefined if the underlying buffer has been detached.
+            // c. Let kValue be ? Get(O, Pk).
+            let k_value = ops::get(agent, o, pk)?;
+            // d. Let testResult be ? Call(predicate, thisArg, « kValue, 𝔽(k), O »).
+            let mark = agent.push_root(k_value);
+            agent.push_root_key(pk);
+            let test_result = ops::call_rooted(
+                agent,
+                predicate,
+                this_arg,
+                &[k_value, Value::Number(k), Value::Object(o)],
+            )?;
+            // e. If ToBoolean(testResult) is true, return the FindViaPredicate Record { [[Index]]: 𝔽(k), [[Value]]: kValue }.
+            if ops::to_boolean(agent, test_result) {
+                agent.pop_roots(mark);
+                return Ok(FindRecord {
+                    index: k,
+                    value: k_value,
+                });
+            }
+            agent.pop_roots(mark);
+            position += 1.0;
+        }
+        // 4. Return the FindViaPredicate Record { [[Index]]: -1𝔽, [[Value]]: undefined }.
+        Ok(FindRecord {
+            index: -1.0,
+            value: Value::Undefined,
+        })
+    })
 }
