+/// The NFC form of a String, as UTF-16 code units.
+fn nfc_code_units(units: &[u16]) -> Vec<u16> {
+    let code_points = to_code_points(units);
+    from_code_points(&normalize_code_points(&code_points, NormalizationForm::Nfc))
