+        let aggregate_error = new_aggregate_error(agent, &errors)?;
+        // 3. Return ? Call(resultCapability.[[Reject]], undefined, « aggregateError »).
+        return ops::call(agent, reject, Value::Undefined, &[aggregate_error]);
