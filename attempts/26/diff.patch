 //!
 //! Spec: https://tc39.es/ecma262/#sec-promise.any
 
+use kahvi_core::function::builtin_slots;
+use kahvi_core::object::PropertyDescriptor;
+use kahvi_core::ops::promise::{self, PromiseCapability};
+use kahvi_core::ops::{IteratorKind, IteratorRecord};
 use kahvi_core::prelude::*;
 
+/// The shared state of one Promise.any call: the [[errors]] list, the
+/// remainingElementsCount record, and the capability's [[Reject]].
+#[derive(Debug)]
+struct PromiseAnyState {
+    errors: Vec<Value>,
+    remaining_elements_count: usize,
+    reject: Value,
+}
+
+/// The [[AlreadyCalled]] and [[Index]] slots of a reject element function.
+#[derive(Debug)]
+struct ElementRecord {
+    already_called: bool,
+    index: usize,
+}
+
 /// Promise.any
 pub(crate) fn any(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
+) -> JsResult<Value> {
+    // 1. Let C be the this value.
+    let c = this;
+    // 2. Let promiseCapability be ? NewPromiseCapability(C).
+    let promise_capability = promise::new_promise_capability(agent, c)?;
+    let Value::Object(ctor) = c else {
+        return Err(agent.throw_type_error("Promise.any called on a non-object"));
+    };
+    // 3. Let promiseResolve be Completion(GetPromiseResolve(C)).
+    let promise_resolve = get_promise_resolve(agent, ctor);
+    // 4. IfAbruptRejectPromise(promiseResolve, promiseCapability).
+    let promise_resolve = match promise_resolve {
+        Ok(f) => f,
+        Err(e) => return reject_abrupt(agent, &promise_capability, e),
+    };
+    // 5. Let iteratorRecord be Completion(GetIterator(iterable, sync)).
+    let iterable = args.get_or_undefined(0);
+    let iterator_record = ops::get_iterator(agent, iterable, IteratorKind::Sync);
+    // 6. IfAbruptRejectPromise(iteratorRecord, promiseCapability).
+    let mut iterator_record = match iterator_record {
+        Ok(r) => r,
+        Err(e) => return reject_abrupt(agent, &promise_capability, e),
+    };
+    // 7. Let result be Completion(PerformPromiseAny(iteratorRecord, C, promiseCapability, promiseResolve)).
+    let result = perform_promise_any(
+        agent,
+        &mut iterator_record,
+        ctor,
+        &promise_capability,
+        promise_resolve,
+    );
+    let result = match result {
+        Ok(v) => Ok(v),
+        Err(e) => {
+            // 8. If result is an abrupt completion, then
+            // a. If iteratorRecord.[[Done]] is false, set result to Completion(IteratorClose(iteratorRecord, result)).
+            if iterator_record.done {
+                Err(e)
+            } else {
+                ops::iterator_close(agent, &iterator_record, Err::<Value, _>(e))
+            }
+        }
+    };
+    // b. IfAbruptRejectPromise(result, promiseCapability).
+    match result {
+        Ok(v) => Ok(v),
+        Err(e) => reject_abrupt(agent, &promise_capability, e),
+    }
+    // 9. Return ! result.
+}
+
+/// IfAbruptRejectPromise for a throw completion: reject the capability with
+/// the thrown value and return its promise. Other abrupt completions propagate.
+fn reject_abrupt(
+    agent: &mut Agent,
+    capability: &PromiseCapability,
+    error: JsError,
+) -> JsResult<Value> {
+    match error {
+        // 1. Perform ? Call(capability.[[Reject]], undefined, « error.[[Value]] »).
+        JsError::Throw(e) => {
+            ops::call(agent, capability.reject, Value::Undefined, &[e])?;
+            // 2. Return capability.[[Promise]].
+            Ok(capability.promise)
+        }
+        other => Err(other),
+    }
+}
+
+/// GetPromiseResolve ( _promiseCtor_ ) (§27.2.4.7.2)
+fn get_promise_resolve(agent: &mut Agent, promise_ctor: Object) -> JsResult<Value> {
+    // 1. Let promiseResolve be ? Get(promiseCtor, "resolve").
+    let key = agent.key("resolve");
+    let promise_resolve = ops::get(agent, promise_ctor, key)?;
+    // 2. If IsCallable(promiseResolve) is false, throw a TypeError exception.
+    if !ops::is_callable(agent, promise_resolve) {
+        return Err(agent.throw_type_error("Promise.resolve is not a function"));
+    }
+    // 3. Return promiseResolve.
+    Ok(promise_resolve)
+}
+
+/// Creates a newly created AggregateError object whose "errors" property is
+/// the given list (the first steps of the AggregateError-producing branches of
+/// PerformPromiseAny).
+fn new_aggregate_error(agent: &mut Agent, errors: &[Value]) -> JsResult<Value> {
+    // 1. Let aggregateError be a newly created AggregateError object.
+    let proto = agent.intrinsic("%AggregateError.prototype%");
+    let aggregate_error = agent.object_with_kind(Some(proto), ObjectKind::Error);
+    // 2. Perform ! DefinePropertyOrThrow(aggregateError, "errors", PropertyDescriptor { [[Configurable]]: true, [[Enumerable]]: false, [[Writable]]: true, [[Value]]: CreateArrayFromList(errors) }).
+    let errors_array = ops::create_array_from_list(agent, errors);
+    let key = agent.key("errors");
+    let desc = PropertyDescriptor::data(Value::Object(errors_array), true, false, true);
+    ops::define_property_or_throw(agent, aggregate_error, key, desc)?;
+    Ok(Value::Object(aggregate_error))
+}
+
+/// PerformPromiseAny ( _iteratorRecord_, _ctor_, _resultCapability_, _promiseResolve_ ) (§27.2.4.3.1)
+fn perform_promise_any(
+    agent: &mut Agent,
+    iterator_record: &mut IteratorRecord,
+    ctor: Object,
+    result_capability: &PromiseCapability,
+    promise_resolve: Value,
+) -> JsResult<Value> {
+    // 1. Let errors be a new empty List.
+    // 2. NOTE: remainingElementsCount starts at 1 instead of 0 to ensure
+    //    resultCapability.[[Reject]] is only called once, even in the presence of a
+    //    misbehaving "then" which calls the passed callback before the input iterator is exhausted.
+    // 3. Let remainingElementsCount be the Record { [[Value]]: 1 }.
+    let proto = agent.intrinsic("%Object.prototype%");
+    let state = agent.object_with_kind(
+        Some(proto),
+        ObjectKind::Native(Box::new(PromiseAnyState {
+            errors: Vec::new(),
+            remaining_elements_count: 1,
+            reject: result_capability.reject,
+        })),
+    );
+    // 4. Let index be 0.
+    let mut index: usize = 0;
+    // 5. Repeat,
+    loop {
+        // a. Let next be ? IteratorStepValue(iteratorRecord).
+        let next = ops::iterator_step_value(agent, iterator_record)?;
+        match next {
+            // b. If next is done, then
+            None => {
+                let Some(state_record) = agent.native_mut::<PromiseAnyState>(state) else {
+                    return Err(agent.not_implemented("Promise.any state record"));
+                };
+                // i. Set remainingElementsCount.[[Value]] to remainingElementsCount.[[Value]] - 1.
+                state_record.remaining_elements_count =
+                    state_record.remaining_elements_count.saturating_sub(1);
+                // ii. If remainingElementsCount.[[Value]] = 0, then
+                if state_record.remaining_elements_count == 0 {
+                    let errors = state_record.errors.clone();
+                    let reject = state_record.reject;
+                    // 1-2. Let aggregateError be a newly created AggregateError object, with its "errors" property set.
+                    let aggregate_error = new_aggregate_error(agent, &errors)?;
+                    // 3. Perform ? Call(resultCapability.[[Reject]], undefined, « aggregateError »).
+                    ops::call(agent, reject, Value::Undefined, &[aggregate_error])?;
+                }
+                // iii. Return resultCapability.[[Promise]].
+                return Ok(result_capability.promise);
+            }
+            Some(next) => {
+                // c. Append undefined to errors.
+                let Some(state_record) = agent.native_mut::<PromiseAnyState>(state) else {
+                    return Err(agent.not_implemented("Promise.any state record"));
+                };
+                state_record.errors.push(Value::Undefined);
+                // d. Let nextPromise be ? Call(promiseResolve, ctor, « next »).
+                let next_promise = ops::call(agent, promise_resolve, Value::Object(ctor), &[next])?;
+                // e-h. Let onRejected be CreateBuiltinFunction(rejectedSteps, 1, "", « [[AlreadyCalled]], [[Index]] »),
+                // with [[AlreadyCalled]] false and [[Index]] index.
+                let proto = agent.intrinsic("%Object.prototype%");
+                let element_record = agent.object_with_kind(
+                    Some(proto),
+                    ObjectKind::Native(Box::new(ElementRecord {
+                        already_called: false,
+                        index,
+                    })),
+                );
+                let empty = PropertyKey::String(agent.names.empty);
+                let on_rejected = create_builtin_function(
+                    agent,
+                    promise_any_reject_element,
+                    1,
+                    empty,
+                    vec![Value::Object(state), Value::Object(element_record)],
+                    None,
+                    None,
+                    None,
+                    false,
+                );
+                // i. Set index to index + 1.
+                index += 1;
+                // j. Set remainingElementsCount.[[Value]] to remainingElementsCount.[[Value]] + 1.
+                let Some(state_record) = agent.native_mut::<PromiseAnyState>(state) else {
+                    return Err(agent.not_implemented("Promise.any state record"));
+                };
+                state_record.remaining_elements_count += 1;
+                // k. Perform ? Invoke(nextPromise, "then", « resultCapability.[[Resolve]], onRejected »).
+                let then_key = PropertyKey::String(agent.names.then);
+                ops::invoke(
+                    agent,
+                    next_promise,
+                    then_key,
+                    &[result_capability.resolve, Value::Object(on_rejected)],
+                )?;
+            }
+        }
+    }
+}
