     // 7. Let _boolTrapResult_ be ToBoolean(? Call(_trap_, _handler_, « _target_ »)).
+    let trap_result = ops::call(
+        agent,
+        trap,
+        Value::Object(handler),
+        &[Value::Object(target)],
