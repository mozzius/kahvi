+/// The value of a standard base64 alphabet code unit.
+fn base64_value(unit: u16) -> Option<u8> {
+    match unit {
+        0x41..=0x5A => Some((unit - 0x41) as u8),
+        0x61..=0x7A => Some((unit - 0x61) as u8 + 26),
+        0x30..=0x39 => Some((unit - 0x30) as u8 + 52),
+        0x2B => Some(62),
+        0x2F => Some(63),
+        _ => None,
+    }
+}
+
+/// SkipAsciiWhitespace ( _string_, _index_ ) (sec-skipasciiwhitespace)
+fn skip_ascii_whitespace(string: &[u16], mut index: usize) -> usize {
+    // 1. Let _length_ be the length of _string_.
+    // 2. Repeat, while _index_ < _length_,
+    while index < string.len() {
+        // a. Let _char_ be the substring of _string_ from _index_ to _index_ + 1.
+        // b. If _char_ is not one of 0x0009, 0x000A, 0x000C, 0x000D, or 0x0020, return _index_.
+        if !matches!(string[index], 0x09 | 0x0A | 0x0C | 0x0D | 0x20) {
+            return index;
+        }
+        // c. Set _index_ to _index_ + 1.
+        index += 1;
+    }
+    // 3. Return _index_.
+    index
+}
+
+/// DecodeFullLengthBase64Chunk ( _chunk_ ) (sec-decodefulllengthbase64chunk).
+/// `chunk` holds four sextet values.
+fn decode_full_length_base64_chunk(chunk: &[u8; 4]) -> [u8; 3] {
+    // Decode the four sextets into three bytes.
+    let n = (u32::from(chunk[0]) << 18)
+        | (u32::from(chunk[1]) << 12)
+        | (u32::from(chunk[2]) << 6)
+        | u32::from(chunk[3]);
+    [(n >> 16) as u8, (n >> 8) as u8, n as u8]
+}
+
+/// DecodeFinalBase64Chunk ( _chunk_, _throwOnExtraBits_ ) (sec-decodefinalbase64chunk).
+/// `chunk` holds two or three sextet values; `Err` is the SyntaxError message.
+fn decode_final_base64_chunk(
+    chunk: &[u8],
+    throw_on_extra_bits: bool,
+) -> Result<Vec<u8>, &'static str> {
+    // 1. Let _chunkLength_ be the length of _chunk_.
+    // 2. If _chunkLength_ = 2, pad _chunk_ with "AA"; else (_chunkLength_ = 3) pad it with "A".
+    // 3. Let _byteSequence_ be the decoding of the padded chunk.
+    let mut padded = [0u8; 4];
+    padded[..chunk.len()].copy_from_slice(chunk);
+    let bytes = decode_full_length_base64_chunk(&padded);
+    if chunk.len() == 2 {
+        // If _throwOnExtraBits_ is *true* and _bytes_[1] ≠ 0, throw a *SyntaxError* exception.
+        if throw_on_extra_bits && bytes[1] != 0 {
+            return Err("base64 string has non-zero padding bits");
+        }
+        // Return « _bytes_[0] ».
+        Ok(vec![bytes[0]])
+    } else {
+        // If _throwOnExtraBits_ is *true* and _bytes_[2] ≠ 0, throw a *SyntaxError* exception.
+        if throw_on_extra_bits && bytes[2] != 0 {
+            return Err("base64 string has non-zero padding bits");
+        }
+        // Return « _bytes_[0], _bytes_[1] ».
+        Ok(vec![bytes[0], bytes[1]])
+    }
+}
