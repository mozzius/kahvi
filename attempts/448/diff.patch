+use crate::support::typed_array::set_view_value;
+
 /// DataView.prototype.setBigUint64
 pub(crate) fn prototype_set_big_uint64(
     agent: &mut Agent,
@@ -11,11 +14,26 @@ pub(crate) fn prototype_set_big_uint64(
     args: &[Value],
     new_target: Option<Object>,
 ) -> JsResult<Value> {
+    let _ = new_target;
     // This method performs the following steps when called:
     //
     // 1. Let _view_ be the *this* value.
-    // 2. Perform ? SetViewValue(_view_, _byteOffset_, _littleEndian_, ~biguint64~, _value_).
-    // 3. Return *undefined*.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("DataView.prototype.setBigUint64"))
+    let view = this;
+    // 2. If _littleEndian_ is not present, set _littleEndian_ to *false*.
+    let little_endian = if args.len() > 2 {
+        args[2]
+    } else {
+        Value::Boolean(false)
+    };
+    // 3. Perform ? SetViewValue(_view_, _byteOffset_, _littleEndian_, ~biguint64~, _value_).
+    set_view_value(
+        agent,
+        view,
+        args.get_or_undefined(0),
+        little_endian,
+        ElementType::BigUint64,
+        args.get_or_undefined(1),
+    )?;
+    // 4. Return *undefined*.
+    Ok(Value::Undefined)
