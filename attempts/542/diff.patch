+/// IsWellFormedCurrencyCode ( _currency_ )
+fn is_well_formed_currency_code(currency: &str) -> bool {
+    // 1. Let _normalized_ be the ASCII-uppercase of _currency_.
+    // 2. If the length of _normalized_ is not 3, return *false*.
+    // 3. If _normalized_ contains any code unit outside of 0x0041 through 0x005A (corresponding to Unicode characters LATIN CAPITAL LETTER A through LATIN CAPITAL LETTER Z), return *false*.
+    // 4. Return *true*.
+    currency.len() == 3 && currency.bytes().all(|b| b.is_ascii_alphabetic())
+}
+
+/// IsWellFormedUnitIdentifier ( _unitIdentifier_ )
+fn is_well_formed_unit_identifier(unit_identifier: &str) -> bool {
+    // 1. If the substring "-per-" does not occur exactly once in _unitIdentifier_, then
+    //    a. If IsSanctionedSimpleUnitIdentifier(_unitIdentifier_) is *true*, return *true*; else return *false*.
+    // 2. Let _numerator_ be the substring of _unitIdentifier_ from the beginning to just before "-per-".
+    // 3. If IsSanctionedSimpleUnitIdentifier(_numerator_) is *false*, return *false*.
+    // 4. Let _denominator_ be the substring of _unitIdentifier_ from just after "-per-" to the end.
+    // 5. If IsSanctionedSimpleUnitIdentifier(_denominator_) is *false*, return *false*.
+    // 6. Return *true*.
+    let mut parts = unit_identifier.split("-per-");
+    match (parts.next(), parts.next(), parts.next()) {
+        (Some(u), None, _) => SANCTIONED_UNITS.contains(&u),
+        (Some(n), Some(d), None) => SANCTIONED_UNITS.contains(&n) && SANCTIONED_UNITS.contains(&d),
+        _ => false,
+    }
+}
