+/// The internal slots of a RegExp String Iterator Object Instance
+/// ([[IteratingRegExp]], [[IteratedString]], [[Global]], [[Unicode]] and [[Done]]).
+/// CreateRegExpStringIterator stores one in `ObjectKind::Native`.
+#[derive(Debug)]
+#[allow(dead_code)] // constructed by CreateRegExpStringIterator (RegExp.prototype[@@matchAll])
+pub(crate) struct RegExpStringIterator {
+    pub(crate) iterating_regexp: Object,
+    pub(crate) iterated_string: JsString,
+    pub(crate) global: bool,
+    pub(crate) unicode: bool,
+    pub(crate) done: bool,
+}
+
+impl kahvi_core::gc::Trace for RegExpStringIterator {
+    fn trace(&self, t: &mut kahvi_core::gc::Tracer) {
+        t.object(self.iterating_regexp);
+        t.string(self.iterated_string);
+    }
+}
+
+/// %RegExpStringIteratorPrototype%.next
 pub(crate) fn next(
     agent: &mut Agent,
     this: Value,
-    args: &[Value],
-    new_target: Option<Object>,
+    _args: &[Value],
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
     // 1. Let _iteratorObj_ be the *this* value.
     // 2. If _iteratorObj_ is not an Object, throw a *TypeError* exception.
-    // 3. If _iteratorObj_ does not have all of the internal slots of a RegExp String Iterator Object Instance (see [sec-properties-of-regexp-string-iterator-instances]), throw a *TypeError* exception.
+    let Value::Object(iterator_obj) = this else {
+        return Err(
+            agent.throw_type_error("RegExpStringIterator.prototype.next called on a non-object")
+        );
+    };
+    // 3. If _iteratorObj_ does not have all of the internal slots of a RegExp String Iterator
+    //    Object Instance (see [sec-properties-of-regexp-string-iterator-instances]), throw a
+    //    *TypeError* exception.
+    let Some(state) = agent.native::<RegExpStringIterator>(iterator_obj) else {
+        return Err(agent.throw_type_error(
+            "RegExpStringIterator.prototype.next called on an incompatible receiver",
+        ));
+    };
     // 4. If _iteratorObj_.[[Done]] is *true*, then
-    //    a. Return CreateIteratorResultObject(*undefined*, *true*).
+    if state.done {
+        // a. Return CreateIteratorResultObject(*undefined*, *true*).
+        return Ok(Value::Object(ops::create_iter_result_object(
+            agent,
+            Value::Undefined,
+            true,
+        )));
+    }
     // 5. Let _regexp_ be _iteratorObj_.[[IteratingRegExp]].
+    let regexp = state.iterating_regexp;
     // 6. Let _string_ be _iteratorObj_.[[IteratedString]].
+    let string = state.iterated_string;
     // 7. Let _global_ be _iteratorObj_.[[Global]].
+    let global = state.global;
     // 8. Let _fullUnicode_ be _iteratorObj_.[[Unicode]].
-    // 9. Let _match_ be ? RegExpExec(_regexp_, _string_).
-    // 10. If _match_ is *null*, then
-    //    a. Set _iteratorObj_.[[Done]] to *true*.
-    //    b. Return CreateIteratorResultObject(*undefined*, *true*).
-    // 11. If _global_ is *false*, then
-    //    a. Set _iteratorObj_.[[Done]] to *true*.
-    //    b. Return CreateIteratorResultObject(_match_, *false*).
-    // 12. Let _matchString_ be ? ToString(? Get(_match_, *"0"*)).
-    // 13. If _matchString_ is the empty String, then
-    //    a. Let _thisIndex_ be ℝ(? ToLength(? Get(_regexp_, *"lastIndex"*))).
-    //    b. Let _nextIndex_ be AdvanceStringIndex(_string_, _thisIndex_, _fullUnicode_).
-    //    c. Perform ? Set(_regexp_, *"lastIndex"*, 𝔽(_nextIndex_), *true*).
-    // 14. Return CreateIteratorResultObject(_match_, *false*).
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("RegExpStringIteratorPrototype.next"))
+    let full_unicode = state.unicode;
+    // RegExpExec and the lastIndex accesses may run user code and collect garbage.
+    agent.with_roots(
+        &[
+            Value::Object(iterator_obj),
+            Value::Object(regexp),
+            Value::String(string),
+        ],
+        |agent| {
+            // 9. Let _match_ be ? RegExpExec(_regexp_, _string_).
+            let m = regexp_exec(agent, regexp, string)?;
+            let m = match m {
+                // 10. If _match_ is *null*, then
+                Value::Null => {
+                    // a. Set _iteratorObj_.[[Done]] to *true*.
+                    set_done(agent, iterator_obj);
+                    // b. Return CreateIteratorResultObject(*undefined*, *true*).
+                    return Ok(Value::Object(ops::create_iter_result_object(
+                        agent,
+                        Value::Undefined,
+                        true,
+                    )));
+                }
+                // RegExpExec returns an Object or *null* (§22.2.7.1 step 2.b).
+                Value::Object(m) => m,
+                _ => {
+                    return Err(agent.throw_type_error("exec result must be an object or null"));
+                }
+            };
+            // 11. If _global_ is *false*, then
+            if !global {
+                // a. Set _iteratorObj_.[[Done]] to *true*.
+                set_done(agent, iterator_obj);
+                // b. Return CreateIteratorResultObject(_match_, *false*).
+                return Ok(Value::Object(ops::create_iter_result_object(
+                    agent,
+                    Value::Object(m),
+                    false,
+                )));
+            }
+            // 12. Let _matchString_ be ? ToString(? Get(_match_, *"0"*)).
+            let zero = agent.key_from_index(0.0);
+            let match_value = ops::get(agent, m, zero)?;
+            let match_string = ops::to_string(agent, match_value)?;
+            // 13. If _matchString_ is the empty String, then
+            if agent.str_len(match_string) == 0 {
+                // a. Let _thisIndex_ be ℝ(? ToLength(? Get(_regexp_, *"lastIndex"*))).
+                let last_index_key = agent.key("lastIndex");
+                let last_index = ops::get(agent, regexp, last_index_key)?;
+                let this_index = ops::to_length(agent, last_index)?;
+                // b. Let _nextIndex_ be AdvanceStringIndex(_string_, _thisIndex_, _fullUnicode_).
+                let next_index = advance_string_index(agent.str(string), this_index, full_unicode);
+                // c. Perform ? Set(_regexp_, *"lastIndex"*, 𝔽(_nextIndex_), *true*).
+                let last_index_key = agent.key("lastIndex");
+                ops::set(
+                    agent,
+                    regexp,
+                    last_index_key,
+                    Value::Number(next_index),
+                    true,
+                )?;
+            }
+            // 14. Return CreateIteratorResultObject(_match_, *false*).
+            Ok(Value::Object(ops::create_iter_result_object(
+                agent,
+                Value::Object(m),
+                false,
+            )))
+        },
+    )
+}
+
+/// Sets [[Done]] of a RegExp String Iterator Object Instance to *true*.
+fn set_done(agent: &mut Agent, iterator_obj: Object) {
+    agent
+        .native_mut::<RegExpStringIterator>(iterator_obj)
+        .expect("RegExpStringIterator slots on a receiver checked by next")
+        .done = true;
 }
