diff --git a/crates/kahvi-builtins/src/support/intl_segmenter.rs b/crates/kahvi-builtins/src/support/intl_segmenter.rs
index 736d8b8..9566cf2 100644
--- a/crates/kahvi-builtins/src/support/intl_segmenter.rs
