+/// The Abstract Closure of step 3.a.
+fn compare_closure(
+    agent: &mut Agent,
+    _this: Value,
+    args: &[Value],
+    _new_target: Option<Object>,
+) -> JsResult<Value> {
+    let collator = match agent.active_function() {
+        Some(f) => builtin_slots(agent, f)[0],
+        None => Value::Undefined,
+    };
+    let Value::Object(collator) = collator else {
+        return Err(agent.throw_type_error("compare function without its collator"));
+    };
+    // i. Let _xString_ be ? ToString(_x_).
+    let x_string = ops::to_string(agent, args.get_or_undefined(0))?;
+    // ii. Let _yString_ be ? ToString(_y_).
+    let y_string = ops::to_string(agent, args.get_or_undefined(1))?;
+    // iii. Return CompareStrings(_collator_, _xString_, _yString_).
+    let Some(slots) = agent.native::<CollatorSlots>(collator) else {
+        return Err(agent.throw_type_error("not an Intl.Collator"));
+    };
