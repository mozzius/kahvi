 //! Intl.Collator: the [[InitializedCollator]] internal slots and the
 //! abstract operations shared by its built-ins.
-//!
-//! The ticket for this service owns this file: define the internal-slot
-//! struct here (`ObjectKind::Native`, see docs/INTL.md) and the abstract
-//! operations more than one of its built-ins needs.
 #![allow(dead_code)] // helpers for the Intl tickets
+
+use std::cmp::Ordering;
+
+use icu::collator::options::{
+    AlternateHandling, CaseLevel, CollatorOptions, MaxVariable, Strength,
+};
+use icu::collator::preferences::{CollationCaseFirst, CollationNumericOrdering, CollationType};
+use icu::collator::provider::{Baked, CollationMetadataV1};
+use icu::collator::{CollatorBorrowed, CollatorPreferences};
+use icu::locale::Locale;
+use icu::locale::extensions::unicode::Value as UnicodeValue;
+use icu::locale::fallback::LocaleFallbacker;
+use icu_provider::{
+    DataIdentifierBorrowed, DataLocale, DataMarkerAttributes, DataProvider, DataRequest,
+};
+use kahvi_core::gc::{Trace, Tracer};
+use kahvi_core::prelude::*;
+
+use crate::support::intl::{
+    OptionType, ResolutionOptionDescriptor, ServiceConstructor, available_locales,
+};
+
+/// The internal slots of an Intl.Collator, plus the ICU4X collator built
+/// from them.
+#[derive(Debug)]
+pub(crate) struct CollatorSlots {
+    /// [[Locale]]
+    pub locale: String,
+    /// [[Usage]]
+    pub usage: String,
+    /// [[Collation]]
+    pub collation: String,
+    /// [[Numeric]]
+    pub numeric: bool,
+    /// [[CaseFirst]]
+    pub case_first: String,
+    /// [[Sensitivity]]
+    pub sensitivity: String,
+    /// [[IgnorePunctuation]]
+    pub ignore_punctuation: bool,
+    /// [[BoundCompare]]
+    pub bound_compare: Option<Object>,
+    /// The ICU4X collator CompareStrings uses.
+    pub collator: CollatorBorrowed<'static>,
+}
+
+impl Trace for CollatorSlots {
+    fn trace(&self, t: &mut Tracer) {
+        self.bound_compare.trace(t);
+    }
+}
+
+/// %Intl.Collator%.[[RelevantExtensionKeys]]
+pub(crate) const RELEVANT_EXTENSION_KEYS: &[&str] = &["co", "kf", "kn"];
+
+/// %Intl.Collator%.[[ResolutionOptionDescriptors]]
+pub(crate) const RESOLUTION_OPTION_DESCRIPTORS: &[ResolutionOptionDescriptor] = &[
+    ResolutionOptionDescriptor {
+        key: "co",
+        property: "collation",
+        r#type: OptionType::String,
+        values: None,
+    },
+    ResolutionOptionDescriptor {
+        key: "kf",
+        property: "caseFirst",
+        r#type: OptionType::String,
+        values: Some(&["upper", "lower", "false"]),
+    },
+    ResolutionOptionDescriptor {
+        key: "kn",
+        property: "numeric",
+        r#type: OptionType::Boolean,
+        values: None,
+    },
+];
+
+/// %Intl.Collator% as ResolveOptions reads it.
+pub(crate) fn service_constructor() -> ServiceConstructor<'static> {
+    ServiceConstructor {
+        available_locales: available_locales(),
+        relevant_extension_keys: RELEVANT_EXTENSION_KEYS,
+        resolution_option_descriptors: RESOLUTION_OPTION_DESCRIPTORS,
+    }
+}
+
+/// RequireInternalSlot(_collator_, [[InitializedCollator]])
+pub(crate) fn require_collator(agent: &mut Agent, v: Value) -> JsResult<Object> {
+    match v {
+        Value::Object(o) if agent.native::<CollatorSlots>(o).is_some() => Ok(o),
+        _ => Err(agent.throw_type_error("not an Intl.Collator")),
+    }
+}
+
+fn parse_locale(locale: &str) -> Locale {
+    locale.parse::<Locale>().unwrap_or(Locale::UNKNOWN)
+}
+
+fn collation_type(name: &str) -> Option<CollationType> {
+    let value = UnicodeValue::try_from_str(name).ok()?;
+    CollationType::try_from(&value).ok()
+}
+
+/// The collation types ICU4X can have data for, other than the ones
+/// ECMA-402 excludes from [[SortLocaleData]] (*"standard"* and *"search"*).
+const COLLATION_CANDIDATES: &[&str] = &[
+    "compat", "dict", "ducet", "emoji", "eor", "phonebk", "phonetic", "pinyin", "searchjl",
+    "stroke", "trad", "unihan", "zhuyin",
+];
+
+/// Whether ICU4X has collation data of `collation` for `locale` (or a locale
+/// it falls back to).
+fn has_collation_data(locale: &Locale, collation: &str) -> bool {
+    let Ok(attributes) = DataMarkerAttributes::try_from_str(collation) else {
+        return false;
+    };
+    let fallbacker = LocaleFallbacker::new();
+    let mut iterator = fallbacker
+        .for_config(Default::default())
+        .fallback_for(DataLocale::from(locale));
+    loop {
+        let request = DataRequest {
+            id: DataIdentifierBorrowed::for_marker_attributes_and_locale(
+                attributes,
+                iterator.get(),
+            ),
+            ..Default::default()
+        };
+        if DataProvider::<CollationMetadataV1>::load(&Baked, request).is_ok() {
+            return true;
+        }
+        if iterator.get().is_unknown() {
+            return false;
+        }
+        iterator.step();
+    }
+}
+
+/// [[SortLocaleData]] / [[SearchLocaleData]] (by `search`) for `locale` and
+/// `key`: the supported values, the default first.
+pub(crate) fn locale_data(search: bool, locale: &str, key: &str) -> Vec<Option<String>> {
+    let locale = parse_locale(locale);
+    match key {
+        "co" => {
+            let mut list = vec![None];
+            if !search {
+                list.extend(
+                    COLLATION_CANDIDATES
+                        .iter()
+                        .filter(|c| has_collation_data(&locale, c))
+                        .map(|c| Some(c.to_string())),
+                );
+            }
+            list
+        }
+        "kf" => {
+            let default = default_options(&locale).0;
+            let mut list = vec![Some(case_first_name(default).to_string())];
+            for other in [
+                CollationCaseFirst::False,
+                CollationCaseFirst::Lower,
+                CollationCaseFirst::Upper,
+            ] {
+                if other != default {
+                    list.push(Some(case_first_name(other).to_string()));
+                }
+            }
+            list
+        }
+        "kn" => vec![Some("false".to_string()), Some("true".to_string())],
+        _ => Vec::new(),
+    }
+}
+
+fn case_first_name(case_first: CollationCaseFirst) -> &'static str {
+    match case_first {
+        CollationCaseFirst::Upper => "upper",
+        CollationCaseFirst::Lower => "lower",
+        _ => "false",
+    }
+}
+
+fn parse_case_first(name: &str) -> CollationCaseFirst {
+    match name {
+        "upper" => CollationCaseFirst::Upper,
+        "lower" => CollationCaseFirst::Lower,
+        _ => CollationCaseFirst::False,
+    }
+}
+
+/// The locale's default [[CaseFirst]], [[sensitivity]] and
+/// [[ignorePunctuation]], as ICU4X resolves them for `locale`.
+pub(crate) fn default_options(locale: &Locale) -> (CollationCaseFirst, &'static str, bool) {
+    let prefs = CollatorPreferences::from(locale);
+    match CollatorBorrowed::try_new(prefs, CollatorOptions::default()) {
+        Ok(collator) => {
+            let resolved = collator.resolved_options();
+            let sensitivity = match (resolved.strength, resolved.case_level) {
+                (Strength::Primary, CaseLevel::On) => "case",
+                (Strength::Primary, _) => "base",
+                (Strength::Secondary, _) => "accent",
+                _ => "variant",
+            };
+            (
+                resolved.case_first,
+                sensitivity,
+                resolved.alternate_handling == AlternateHandling::Shifted,
+            )
+        }
+        Err(_) => (CollationCaseFirst::False, "variant", false),
+    }
+}
+
+/// The [[sensitivity]] and [[ignorePunctuation]] defaults of the data for
+/// `locale`.
+pub(crate) fn default_sensitivity_and_ignore_punctuation(locale: &str) -> (&'static str, bool) {
+    let (_, sensitivity, ignore) = default_options(&parse_locale(locale));
+    (sensitivity, ignore)
+}
+
+/// Builds the ICU4X collator for the resolved slots.
+pub(crate) fn build_collator(
+    agent: &mut Agent,
+    data_locale: &str,
+    collation: &str,
+    numeric: bool,
+    case_first: &str,
+    sensitivity: &str,
+    ignore_punctuation: bool,
+) -> JsResult<CollatorBorrowed<'static>> {
+    let locale = parse_locale(data_locale);
+    let mut prefs = CollatorPreferences::from(&locale);
+    prefs.collation_type = collation_type(collation);
+    prefs.case_first = Some(parse_case_first(case_first));
+    prefs.numeric_ordering = Some(if numeric {
+        CollationNumericOrdering::True
+    } else {
+        CollationNumericOrdering::False
+    });
+    let mut options = CollatorOptions::default();
+    let (strength, case_level) = match sensitivity {
+        "base" => (Strength::Primary, CaseLevel::Off),
+        "accent" => (Strength::Secondary, CaseLevel::Off),
+        "case" => (Strength::Primary, CaseLevel::On),
+        _ => (Strength::Tertiary, CaseLevel::Off),
+    };
+    options.strength = Some(strength);
+    options.case_level = Some(case_level);
+    if ignore_punctuation {
+        options.alternate_handling = Some(AlternateHandling::Shifted);
+        options.max_variable = Some(MaxVariable::Punctuation);
+    } else {
+        options.alternate_handling = Some(AlternateHandling::NonIgnorable);
+    }
+    match CollatorBorrowed::try_new(prefs, options) {
+        Ok(collator) => Ok(collator),
+        Err(_) => Err(agent.not_implemented("Intl.Collator data for the resolved locale")),
+    }
+}
+
+/// CompareStrings ( _collator_, _x_, _y_ )
+pub(crate) fn compare_strings(collator: &CollatorSlots, x: &[u16], y: &[u16]) -> f64 {
+    match collator.collator.compare_utf16(x, y) {
+        Ordering::Less => -1.0,
+        Ordering::Equal => 0.0,
+        Ordering::Greater => 1.0,
+    }
+}
