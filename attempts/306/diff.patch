diff --git a/crates/kahvi-builtins/src/error/is_error.rs b/crates/kahvi-builtins/src/error/is_error.rs
index 377e691..33c4e65 100644
--- a/crates/kahvi-builtins/src/error/is_error.rs
+++ b/crates/kahvi-builtins/src/error/is_error.rs
@@ -16,6 +16,16 @@ pub(crate) fn is_error(
     // 1. If _arg_ is not an Object, return *false*.
     // 2. If _arg_ does not have an [[ErrorData]] internal slot, return *false*.
     // 3. Return *true*.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Error.isError"))
+    let _ = (this, new_target);
+    let arg = args.get_or_undefined(0);
+    // 1. If _arg_ is not an Object, return *false*.
+    let Value::Object(o) = arg else {
+        return Ok(Value::Boolean(false));
+    };
+    // 2. If _arg_ does not have an [[ErrorData]] internal slot, return *false*.
+    if !matches!(agent.obj(o).kind, ObjectKind::Error) {
+        return Ok(Value::Boolean(false));
+    }
+    // 3. Return *true*.
+    Ok(Value::Boolean(true))
 }
