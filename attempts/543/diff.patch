+/// %Intl.DateTimeFormat%.[[LocaleData]] for a found locale and extension key.
+fn locale_data(locale: &str, key: &str) -> Vec<Option<String>> {
+    match key {
+        "ca" => {
+            let parsed: Locale = locale.parse().unwrap_or(Locale::UNKNOWN);
+            #[allow(deprecated)]
+            let default = calendar_name(AnyCalendarKind::new(parsed.into()));
+            let mut list = vec![Some(default.to_string())];
+            list.extend(
+                CALENDARS
+                    .iter()
+                    .filter(|c| **c != default)
+                    .map(|c| Some(c.to_string())),
+            );
+            list
+        }
+        "nu" => vec![Some("latn".to_string())],
+        "hc" => vec![
+            None,
+            Some("h11".to_string()),
+            Some("h12".to_string()),
+            Some("h23".to_string()),
+            Some("h24".to_string()),
+        ],
+        _ => Vec::new(),
+    }
+}
