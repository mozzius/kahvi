+/// Parses |UTCOffset| (sign, hours, optional minutes, optional seconds and
+/// fraction; `:` separators all or none). Returns (sign, hours, minutes,
+/// has seconds) when the whole string matches.
+fn parse_utc_offset(s: &str) -> Option<(i32, u32, u32, bool)> {
