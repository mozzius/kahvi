+/// Whether ICU4X formats the time 0:00 / 13:00 of `locale` (with the given
+/// hour cycle preference) showing the hour `needle`.
+fn time_shows(locale: &Locale, hour_cycle: Option<IcuHourCycle>, hour: u8, needle: &str) -> bool {
+    let mut prefs = DateTimeFormatterPreferences::from(locale);
+    prefs.hour_cycle = hour_cycle;
+    let Ok(formatter) = NoCalendarFormatter::try_new(prefs, fieldsets::T::medium()) else {
+        return false;
+    };
+    let Ok(time) = Time::try_new(hour, 0, 0, 0) else {
+        return false;
+    };
+    formatter.format(&time).to_string().contains(needle)
+}
+
+/// The locale data's [[hourCycle]], [[hourCycle12]] and [[hourCycle24]],
+/// taken from what ICU4X formats for the locale.
+fn locale_hour_cycles(data_locale: &str) -> (&'static str, &'static str, &'static str) {
+    let locale: Locale = data_locale.parse().unwrap_or(Locale::UNKNOWN);
+    let default = if time_shows(&locale, None, 13, "13") {
+        "h23"
+    } else if time_shows(&locale, None, 0, "12") {
+        "h12"
+    } else {
+        "h11"
+    };
+    let hour_cycle12 = if time_shows(&locale, Some(IcuHourCycle::H12), 0, "12") {
+        "h12"
+    } else {
+        "h11"
+    };
+    (default, hour_cycle12, "h23")
+}
