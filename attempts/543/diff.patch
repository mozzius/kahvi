+/// A DateTime Format Record, reduced to the component fields the format
+/// carries (ICU4X picks the pattern from them).
+#[derive(Debug, Clone, Default)]
+pub(crate) struct DateTimeFormatRecord {
+    /// ([[<property>]], value) in table order; `fractionalSecondDigits` holds
+    /// its digit count as a string.
+    pub fields: Vec<(&'static str, String)>,
+}
+
+impl DateTimeFormatRecord {
+    pub(crate) fn get(&self, key: &str) -> Option<&str> {
+        self.fields
+            .iter()
+            .find(|(k, _)| *k == key)
+            .map(|(_, v)| v.as_str())
+    }
+}
