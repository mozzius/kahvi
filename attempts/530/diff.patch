diff --git a/crates/kahvi-builtins/src/iterator/prototype_windows.rs b/crates/kahvi-builtins/src/iterator/prototype_windows.rs
index 155691c..5cb348a 100644
--- a/crates/kahvi-builtins/src/iterator/prototype_windows.rs
+++ b/crates/kahvi-builtins/src/iterator/prototype_windows.rs
@@ -2,48 +2,173 @@
 //!
 //! Spec: https://tc39.es/proposal-iterator-chunking/#sec-iterator.prototype.windows
 
+use kahvi_core::ops::IteratorRecord;
 use kahvi_core::prelude::*;
 
+use crate::support::iterator_helper::{HelperClosure, create_iterator_helper, iterator_close_all};
+
 /// Iterator.prototype.windows
 pub(crate) fn prototype_windows(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _O_ be the *this* value.
-    // 2. If _O_ is not an Object, throw a *TypeError* exception.
-    // 3. Let _iterated_ be the Iterator Record { [[Iterator]]: _O_, [[NextMethod]]: *undefined*, [[Done]]: *false* }.
-    // 4. If _windowSize_ is not an integral Number, then
-    //    a. Let _error_ be ThrowCompletion(a newly created *TypeError* object).
-    //    b. Return ? IteratorClose(_iterated_, _error_).
-    // 5. If _windowSize_ is not in the inclusive interval from *1*_𝔽 to 𝔽(2^32 - 1), then
-    //    a. Let _error_ be ThrowCompletion(a newly created *RangeError* object).
-    //    b. Return ? IteratorClose(_iterated_, _error_).
-    // 6. If _undersized_ is *undefined*, set _undersized_ to *"only-full"*.
-    // 7. If _undersized_ is neither *"only-full"* nor *"allow-partial"*, then
-    //    a. Let _error_ be ThrowCompletion(a newly created *TypeError* object).
-    //    b. Return ? IteratorClose(_iterated_, _error_).
-    // 8. Set _iterated_ to ? GetIteratorDirect(_O_).
-    // 9. Let _closure_ be a new Abstract Closure with no parameters that captures _iterated_, _windowSize_, and _undersized_ and performs the following steps when called:
-    //    a. Let _buffer_ be a new empty List.
-    //    b. Repeat,
-    //       i. Let _value_ be ? IteratorStepValue(_iterated_).
-    //       ii. If _value_ is ~done~, then
-    //          1. If _undersized_ is *"allow-partial"*, _buffer_ is not empty, and the number of elements in _buffer_ < ℝ(_windowSize_), then
-    //             a. Perform Completion(Yield(CreateArrayFromList(_buffer_))).
-    //          2. Return ReturnCompletion(*undefined*).
-    //       iii. If the number of elements in _buffer_ is ℝ(_windowSize_), then
-    //          1. Remove the first element from _buffer_.
-    //       iv. Append _value_ to _buffer_.
-    //       v. If the number of elements in _buffer_ is ℝ(_windowSize_), then
-    //          1. Let _completion_ be Completion(Yield(CreateArrayFromList(_buffer_))).
-    //          2. IfAbruptCloseIterator(_completion_, _iterated_).
-    // 10. Let _result_ be CreateIteratorFromClosure(_closure_, *"Iterator Helper"*, %IteratorHelperPrototype%, « [[UnderlyingIterators]] »).
-    // 11. Set _result_.[[UnderlyingIterators]] to « _iterated_ ».
-    // 12. Return _result_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Iterator.prototype.windows"))
+    let window_size = args.get_or_undefined(0);
+    let undersized = args.get_or_undefined(1);
+    // 1. Let O be the this value.
+    // 2. If O is not an Object, throw a TypeError exception.
+    let Value::Object(o) = this else {
+        return Err(agent.throw_type_error("Iterator.prototype.windows called on a non-object"));
+    };
+    // 3. Let iterated be the Iterator Record { [[Iterator]]: O, [[NextMethod]]: undefined, [[Done]]: false }.
+    let iterated = IteratorRecord {
+        iterator: o,
+        next_method: Value::Undefined,
+        done: false,
+    };
+    // 4. If windowSize is not an integral Number, then
+    let window_size = match window_size {
+        Value::Number(n) if ops::is_integral_number(window_size) => n,
+        _ => {
+            // a. Let error be ThrowCompletion(a newly created TypeError object).
+            let error =
+                agent.throw_type_error("Iterator.prototype.windows: windowSize is not an integer");
+            // b. Return ? IteratorClose(iterated, error).
+            return ops::iterator_close(agent, &iterated, Err(error));
+        }
+    };
+    // 5. If windowSize is not in the inclusive interval from 1𝔽 to 𝔽(2^32 - 1), then
+    if !(1.0..=4294967295.0).contains(&window_size) {
+        // a. Let error be ThrowCompletion(a newly created RangeError object).
+        let error =
+            agent.throw_range_error("Iterator.prototype.windows: windowSize is out of range");
+        // b. Return ? IteratorClose(iterated, error).
+        return ops::iterator_close(agent, &iterated, Err(error));
+    }
+    // 6. If undersized is undefined, set undersized to "only-full".
+    // 7. If undersized is neither "only-full" nor "allow-partial", then
+    let allow_partial = match undersized {
+        Value::Undefined => false,
+        Value::String(s)
+            if agent.str(s) == "only-full".encode_utf16().collect::<Vec<u16>>().as_slice() =>
+        {
+            false
+        }
+        Value::String(s)
+            if agent.str(s)
+                == "allow-partial"
+                    .encode_utf16()
+                    .collect::<Vec<u16>>()
+                    .as_slice() =>
+        {
+            true
+        }
+        _ => {
+            // a. Let error be ThrowCompletion(a newly created TypeError object).
+            let error = agent
+                .throw_type_error("Iterator.prototype.windows: undersized is not a valid option");
+            // b. Return ? IteratorClose(iterated, error).
+            return ops::iterator_close(agent, &iterated, Err(error));
+        }
+    };
+    // 8. Set iterated to ? GetIteratorDirect(O).
+    let iterated = ops::get_iterator_direct(agent, o)?;
+    // 9. Let closure be a new Abstract Closure with no parameters that captures iterated,
+    //    windowSize, and undersized and performs the following steps when called:
+    let closure = WindowsClosure {
+        window_size,
+        allow_partial,
+        yielded_partial: false,
+        // a. Let buffer be a new empty List.
+        buffer: Vec::new(),
+    };
+    // 10-12. Let result be CreateIteratorFromClosure(closure, "Iterator Helper", %IteratorHelperPrototype%,
+    //        « [[UnderlyingIterators]] »), with [[UnderlyingIterators]] « iterated ».
+    Ok(Value::Object(create_iterator_helper(
+        agent,
+        Box::new(closure),
+        vec![iterated],
+    )))
+}
+
+/// Step 9's closure: captures windowSize and undersized, and holds buffer between Yields.
+#[derive(Debug)]
+struct WindowsClosure {
+    /// ℝ(windowSize)
+    window_size: f64,
+    /// Whether undersized is "allow-partial" (otherwise "only-full").
+    allow_partial: bool,
+    /// Set once the final partial window has been yielded; the closure then returns on resume.
+    yielded_partial: bool,
+    /// buffer
+    buffer: Vec<Value>,
+}
+
+impl HelperClosure for WindowsClosure {
+    // b. Repeat,
+    fn resume(
+        &mut self,
+        agent: &mut Agent,
+        underlying: &mut [IteratorRecord],
+    ) -> JsResult<Option<Value>> {
+        // The partial window's Yield was resumed, so step 9.b.ii.2 returns undefined.
+        if self.yielded_partial {
+            return Ok(None);
+        }
+        let iterated = &mut underlying[0];
+        loop {
+            // i. Let value be ? IteratorStepValue(iterated).
+            let Some(value) = ops::iterator_step_value(agent, iterated)? else {
+                // ii. If value is done, then
+                // 1. If undersized is "allow-partial", buffer is not empty, and the number of elements
+                //    in buffer < ℝ(windowSize), then
+                if self.allow_partial
+                    && !self.buffer.is_empty()
+                    && (self.buffer.len() as f64) < self.window_size
+                {
+                    // a. Perform Completion(Yield(CreateArrayFromList(buffer))).
+                    // The completion of this Yield is discarded, so on_return closes nothing.
+                    self.yielded_partial = true;
+                    return Ok(Some(Value::Object(ops::create_array_from_list(
+                        agent,
+                        &self.buffer,
+                    ))));
+                }
+                // 2. Return ReturnCompletion(undefined).
+                return Ok(None);
+            };
+            // iii. If the number of elements in buffer is ℝ(windowSize), then
+            if self.buffer.len() as f64 == self.window_size {
+                // 1. Remove the first element from buffer.
+                self.buffer.remove(0);
+            }
+            // iv. Append value to buffer.
+            self.buffer.push(value);
+            // v. If the number of elements in buffer is ℝ(windowSize), then
+            if self.buffer.len() as f64 == self.window_size {
+                // 1. Let completion be Completion(Yield(CreateArrayFromList(buffer))).
+                // 2. IfAbruptCloseIterator(completion, iterated): HelperClosure::on_return.
+                return Ok(Some(Value::Object(ops::create_array_from_list(
+                    agent,
+                    &self.buffer,
+                ))));
+            }
+        }
+    }
+
+    // A return completion resumed at a full window's Yield closes iterated (step 9.b.v.2).
+    // A return completion resumed at the partial window's Yield is discarded (step 9.b.ii.1.a).
+    fn on_return(&mut self, agent: &mut Agent, underlying: &mut [IteratorRecord]) -> JsResult<()> {
+        if self.yielded_partial {
+            return Ok(());
+        }
+        iterator_close_all(agent, underlying, Ok(()))
+    }
+}
+
+impl kahvi_core::gc::Trace for WindowsClosure {
+    fn trace(&self, t: &mut kahvi_core::gc::Tracer) {
+        self.buffer.trace(t);
+    }
 }
