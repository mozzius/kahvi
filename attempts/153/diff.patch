diff --git a/crates/kahvi-builtins/src/weak_set/prototype_add.rs b/crates/kahvi-builtins/src/weak_set/prototype_add.rs
index 5cc7b4e..f407400 100644
--- a/crates/kahvi-builtins/src/weak_set/prototype_add.rs
+++ b/crates/kahvi-builtins/src/weak_set/prototype_add.rs
@@ -2,6 +2,9 @@
 //!
 //! Spec: https://tc39.es/ecma262/#sec-weakset.prototype.add
 
+use crate::support::collections::{
+    can_be_held_weakly, collection_key, this_weak_set, weak_set_table,
+};
 use kahvi_core::prelude::*;
 
 /// WeakSet.prototype.add
@@ -9,18 +12,25 @@ pub(crate) fn prototype_add(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _weakSet_ be the *this* value.
-    // 2. Perform ? RequireInternalSlot(_weakSet_, [[WeakSetData]]).
-    // 3. If CanBeHeldWeakly(_value_) is *false*, throw a *TypeError* exception.
-    // 4. For each element _entry_ of _weakSet_.[[WeakSetData]], do
-    //    a. If _entry_ is not ~empty~ and SameValue(_entry_, _value_) is *true*, then
-    //       i. Return _weakSet_.
-    // 5. Append _value_ to _weakSet_.[[WeakSetData]].
-    // 6. Return _weakSet_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("WeakSet.prototype.add"))
+    // 1. Let weakSet be the this value.
+    // 2. Perform ? RequireInternalSlot(weakSet, [[WeakSetData]]).
+    let weak_set = this_weak_set(agent, this)?;
+    // 3. If CanBeHeldWeakly(value) is false, throw a TypeError exception.
+    let value = args.get_or_undefined(0);
+    if !can_be_held_weakly(agent, value) {
+        return Err(agent.throw_type_error("WeakSet.prototype.add: value cannot be held weakly"));
+    }
+    // 4. For each element entry of weakSet.[[WeakSetData]], do
+    //    a. If entry is not ~empty~ and SameValue(entry, value) is true, then
+    //       i. Return weakSet.
+    let key = collection_key(agent, value);
+    if weak_set_table(agent, weak_set).has(&key) {
+        return Ok(Value::Object(weak_set));
+    }
+    // 5. Append value to weakSet.[[WeakSetData]].
+    weak_set_table(agent, weak_set).set(key, Value::Undefined);
+    // 6. Return weakSet.
+    Ok(Value::Object(weak_set))
 }
