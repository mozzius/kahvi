+    if !n.is_finite() || n == 0.0 {
+        return Ok(Value::Number(n));
+    }
+    // 3. Return an implementation-approximated Number value representing the hyperbolic sine of ℝ(_n_).
+    Ok(Value::Number(n.sinh()))
