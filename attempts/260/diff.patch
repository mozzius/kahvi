diff --git a/crates/kahvi-builtins/src/weak_set/prototype_delete.rs b/crates/kahvi-builtins/src/weak_set/prototype_delete.rs
index 6ecb029..752227b 100644
--- a/crates/kahvi-builtins/src/weak_set/prototype_delete.rs
+++ b/crates/kahvi-builtins/src/weak_set/prototype_delete.rs
@@ -2,6 +2,9 @@
 //!
 //! Spec: https://tc39.es/ecma262/#sec-weakset.prototype.delete
 
+use crate::support::collections::{
+    can_be_held_weakly, collection_key, this_weak_set, weak_set_table,
+};
 use kahvi_core::prelude::*;
 
 /// WeakSet.prototype.delete
@@ -9,21 +12,21 @@ pub(crate) fn prototype_delete(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _weakSet_ be the *this* value.
-    // 2. Perform ? RequireInternalSlot(_weakSet_, [[WeakSetData]]).
-    // 3. If CanBeHeldWeakly(_value_) is *false*, return *false*.
-    // 4. For each element _entry_ of _weakSet_.[[WeakSetData]], do
-    //    a. If _entry_ is not ~empty~ and SameValue(_entry_, _value_) is *true*, then
-    //       i. Replace the element of _weakSet_.[[WeakSetData]] whose value is _entry_ with an element whose value is ~empty~.
-    //       ii. Return *true*.
-    // 5. Return *false*.
-    //
-    // NOTE:
-    // The value ~empty~ is used as a specification device to indicate that an entry has been deleted. Actual implementations may take other actions such as physically removing the entry from internal data structures.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("WeakSet.prototype.delete"))
+    // 1. Let weakSet be the this value.
+    // 2. Perform ? RequireInternalSlot(weakSet, [[WeakSetData]]).
+    let weak_set = this_weak_set(agent, this)?;
+    // 3. If CanBeHeldWeakly(value) is false, return false.
+    let value = args.get_or_undefined(0);
+    if !can_be_held_weakly(agent, value) {
+        return Ok(Value::Boolean(false));
+    }
+    // 4. For each element entry of weakSet.[[WeakSetData]], do
+    //    a. If entry is not ~empty~ and SameValue(entry, value) is true, then
+    //       i. Replace the element of weakSet.[[WeakSetData]] whose value is entry with an element whose value is ~empty~.
+    //       ii. Return true.
+    let key = collection_key(agent, value);
+    // 5. Return false.
+    Ok(Value::Boolean(weak_set_table(agent, weak_set).delete(&key)))
 }
