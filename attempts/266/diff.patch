diff --git a/crates/kahvi-builtins/src/iterator/prototype_to_array.rs b/crates/kahvi-builtins/src/iterator/prototype_to_array.rs
index c9038fe..dfd152d 100644
--- a/crates/kahvi-builtins/src/iterator/prototype_to_array.rs
+++ b/crates/kahvi-builtins/src/iterator/prototype_to_array.rs
@@ -8,19 +8,31 @@ use kahvi_core::prelude::*;
 pub(crate) fn prototype_to_array(
     agent: &mut Agent,
     this: Value,
-    args: &[Value],
-    new_target: Option<Object>,
+    _args: &[Value],
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
     // 1. Let _obj_ be the *this* value.
     // 2. If _obj_ is not an Object, throw a *TypeError* exception.
+    let Value::Object(obj) = this else {
+        return Err(agent.throw_type_error("Iterator.prototype.toArray called on a non-object"));
+    };
     // 3. Let _iterated_ be ? GetIteratorDirect(_obj_).
-    // 4. Let _items_ be a new empty List.
-    // 5. Repeat,
-    //    a. Let _value_ be ? IteratorStepValue(_iterated_).
-    //    b. If _value_ is ~done~, return CreateArrayFromList(_items_).
-    //    c. Append _value_ to _items_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Iterator.prototype.toArray"))
+    let mut iterated = ops::get_iterator_direct(agent, obj)?;
+    // The iterator, its next method and every item collected so far stay rooted
+    // while the iterator runs, since `next()` may collect garbage.
+    agent.with_roots(&[Value::Object(obj), iterated.next_method], |agent| {
+        // 4. Let _items_ be a new empty List.
+        let mut items: Vec<Value> = Vec::new();
+        // 5. Repeat,
+        loop {
+            // a. Let _value_ be ? IteratorStepValue(_iterated_).
+            let Some(value) = ops::iterator_step_value_rooted(agent, &mut iterated)? else {
+                // b. If _value_ is ~done~, return CreateArrayFromList(_items_).
+                return Ok(Value::Object(ops::create_array_from_list(agent, &items)));
+            };
+            // c. Append _value_ to _items_.
+            agent.push_root(value);
+            items.push(value);
+        }
+    })
 }
