+/// Decode ( _string_, _preserveEscapeSet_ )
+///
+/// The abstract operation is not in `kahvi_core::ops` yet; it lives here
+/// until `decodeURI` needs it too.
+fn decode(agent: &mut Agent, string: JsString, preserve_escape_set: &[u16]) -> JsResult<JsString> {
+    // 1. Let strLen be the length of _string_.
+    let units = agent.str(string).to_vec();
+    let str_len = units.len();
+    // 2. Let R be the empty String.
+    let mut r: Vec<u16> = Vec::new();
+    // 3. Let k be 0.
+    let mut k = 0;
+    // 4. Repeat, while k < strLen,
+    while k < str_len {
+        // a. Let C be the code unit at index k within _string_.
+        let Some(&c) = units.get(k) else {
+            break;
+        };
+        // b. If C is not the code unit 0x0025 (PERCENT SIGN), then
+        let s: Vec<u16> = if c != 0x0025 {
+            // i. Let S be the String value containing only the code unit C.
+            vec![c]
+        } else {
+            // c. Else,
+            // i. Let start be k.
+            let start = k;
+            // ii. If k + 2 ≥ strLen, throw a URIError exception.
+            if k + 2 >= str_len {
+                return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+            }
+            // iii. If the code units at indices (k + 1) and (k + 2) do not represent a hexadecimal number, throw a URIError exception.
+            // iv. Let B be the 8-bit value represented by the two hex digits at indices (k + 1) and (k + 2).
+            let Some(b) = hex_byte(&units, k + 1) else {
+                return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+            };
+            // v. Set k to k + 2.
+            k += 2;
+            // vi. Let n be the number of leading 1 bits in B.
+            let n = b.leading_ones();
+            // vii. If n = 0, then
+            if n == 0 {
+                // 1. Let asciiChar be the code unit whose value is B.
+                let ascii_char = u16::from(b);
+                // 2. If asciiChar is in preserveEscapeSet, then
+                if preserve_escape_set.contains(&ascii_char) {
+                    // a. Let S be the substring of string from start to k + 1.
+                    units[start..k + 1].to_vec()
+                } else {
+                    // 3. Else, let S be the String value containing only the code unit asciiChar.
+                    vec![ascii_char]
+                }
+            } else {
+                // viii. Else,
+                // 1. If n = 1 or n > 4, throw a URIError exception.
+                if n == 1 || n > 4 {
+                    return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+                }
+                // 2. Let Octets be « B ».
+                let mut octets = vec![b];
+                // 3. If k + (3 × (n - 1)) ≥ strLen, throw a URIError exception.
+                if k + 3 * (n as usize - 1) >= str_len {
+                    return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+                }
+                // 4. Let j be 1.
+                let mut j = 1;
+                // 5. Repeat, while j < n,
+                while j < n {
+                    // a. Set k to k + 1.
+                    k += 1;
+                    // b. If the code unit at index k within _string_ is not the code unit 0x0025 (PERCENT SIGN), throw a URIError exception.
+                    if units.get(k) != Some(&0x0025) {
+                        return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+                    }
+                    // c. If the code units at indices (k + 1) and (k + 2) do not represent a hexadecimal number, throw a URIError exception.
+                    // d. Let B be the 8-bit value represented by the two hex digits at indices (k + 1) and (k + 2).
+                    let Some(next) = hex_byte(&units, k + 1) else {
+                        return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+                    };
+                    // e. Set k to k + 2.
+                    k += 2;
+                    // f. Append B to Octets.
+                    octets.push(next);
+                    // g. Set j to j + 1.
+                    j += 1;
+                }
+                // 6. Assert: The length of Octets is n.
+                // 7. If Octets does not contain a valid UTF-8 encoding of a Unicode code point, throw a URIError exception.
+                let Ok(text) = std::str::from_utf8(&octets) else {
+                    return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+                };
+                let Some(code_point) = text.chars().next() else {
+                    return Err(agent.throw_error(ErrorKind::Uri, "URI malformed"));
+                };
+                // 8. Let V be the code point obtained by applying the UTF-8 transformation to Octets, that is, from a List of octets into a 21-bit value.
+                // 9. Let S be UTF16EncodeCodePoint(V).
+                let mut buf = [0u16; 2];
+                code_point.encode_utf16(&mut buf).to_vec()
+            }
+        };
+        // d. Set R to the string-concatenation of R and S.
+        r.extend_from_slice(&s);
+        // e. Set k to k + 1.
+        k += 1;
+    }
+    // 5. Return R.
+    Ok(agent.intern(&r))
+}
+
+/// The 8-bit value of the two hex digits at `at` and `at + 1`, if both are hex digits.
+fn hex_byte(units: &[u16], at: usize) -> Option<u8> {
+    let high = hex_digit(*units.get(at)?)?;
+    let low = hex_digit(*units.get(at + 1)?)?;
+    Some(high * 16 + low)
+}
+
+/// The value of a hex digit code unit, if it is one.
+fn hex_digit(unit: u16) -> Option<u8> {
+    let c = char::from_u32(u32::from(unit))?;
+    c.to_digit(16).and_then(|d| u8::try_from(d).ok())
 }
