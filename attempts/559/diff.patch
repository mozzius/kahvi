+/// AvailablePrimaryTimeZoneIdentifiers ( ): the canonical IANA identifiers of
+/// `icu::time`, sorted.
+fn available_primary_time_zone_identifiers() -> Vec<String> {
+    // 1. Let _records_ be AvailableNamedTimeZoneIdentifiers().
+    // (Each record is ICU4X's normalized IANA identifier with its canonical
+    // identifier as [[PrimaryIdentifier]].)
+    let parser = IanaParserExtended::new();
+    // 2. Let _result_ be a new empty List.
+    let mut result: Vec<String> = Vec::new();
+    // 3. For each element _timeZoneIdentifierRecord_ of _records_, do
+    for record in parser.iter_all() {
+        let identifier = record.normalized;
+        // "Etc/Unknown" is ICU4X's placeholder, not an IANA identifier.
+        if identifier == "Etc/Unknown" {
+            continue;
+        }
+        let mut primary = record.canonical;
+        // c. If _primary_ is one of *"Etc/UTC"*, *"Etc/GMT"*, or *"GMT"*, set _primary_ to *"UTC"*.
+        if matches!(primary, "Etc/UTC" | "Etc/GMT" | "GMT") {
+            primary = "UTC";
+        }
+        // a. If _timeZoneIdentifierRecord_.[[Identifier]] is _timeZoneIdentifierRecord_.[[PrimaryIdentifier]], then
+        if identifier == primary {
+            // i. Append _timeZoneIdentifierRecord_.[[Identifier]] to _result_.
+            result.push(identifier.to_string());
+        }
+    }
+    // 4. Return _result_.
+    result.sort();
+    result.dedup();
+    result
 }
