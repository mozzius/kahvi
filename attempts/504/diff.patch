@@ -2,6 +2,7 @@
 //!
 //! Spec: https://tc39.es/ecma262/#sec-json.israwjson
 
+use super::raw_json::RawJsonData;
 use kahvi_core::prelude::*;
 
 /// JSON.isRawJSON
@@ -15,6 +16,12 @@ pub(crate) fn is_raw_json(
     //
     // 1. If _obj_ is an Object and _obj_ has an [[IsRawJSON]] internal slot, return *true*.
     // 2. Return *false*.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("JSON.isRawJSON"))
+    let _ = (this, new_target);
+    let obj = args.first().copied().unwrap_or(Value::Undefined);
+    if let Value::Object(o) = obj {
+        if agent.native::<RawJsonData>(o).is_some() {
+            return Ok(Value::Boolean(true));
+        }
+    }
+    Ok(Value::Boolean(false))
 }
