+use crate::support::collections::{map_table, this_map};
 use kahvi_core::prelude::*;
 
 /// Map.prototype.clear
 pub(crate) fn prototype_clear(
     agent: &mut Agent,
     this: Value,
-    args: &[Value],
-    new_target: Option<Object>,
+    _args: &[Value],
