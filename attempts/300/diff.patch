diff --git a/crates/kahvi-builtins/src/map/prototype_get_or_insert.rs b/crates/kahvi-builtins/src/map/prototype_get_or_insert.rs
index 009b3eb..97910db 100644
--- a/crates/kahvi-builtins/src/map/prototype_get_or_insert.rs
+++ b/crates/kahvi-builtins/src/map/prototype_get_or_insert.rs
@@ -2,6 +2,7 @@
 //!
 //! Spec: https://tc39.es/ecma262/#sec-map.prototype.getorinsert
 
+use crate::support::collections::{collection_key, map_table, this_map};
 use kahvi_core::prelude::*;
 
 /// Map.prototype.getOrInsert
@@ -9,18 +10,22 @@ pub(crate) fn prototype_get_or_insert(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _map_ be the *this* value.
-    // 2. Perform ? RequireInternalSlot(_map_, [[MapData]]).
-    // 3. Set _key_ to CanonicalizeKeyedCollectionKey(_key_).
-    // 4. For each Record { [[Key]], [[Value]] } _entry_ of _map_.[[MapData]], do
-    //    a. If _entry_.[[Key]] is not ~empty~ and SameValue(_entry_.[[Key]], _key_) is *true*, return _entry_.[[Value]].
-    // 5. Let _entry_ be the Record { [[Key]]: _key_, [[Value]]: _value_ }.
-    // 6. Append _entry_ to _map_.[[MapData]].
-    // 7. Return _value_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Map.prototype.getOrInsert"))
+    // 1. Let map be the this value.
+    // 2. Perform ? RequireInternalSlot(map, [[MapData]]).
+    let map = this_map(agent, this)?;
+    // 3. Set key to CanonicalizeKeyedCollectionKey(key).
+    let key = collection_key(agent, args.get_or_undefined(0));
+    let value = args.get_or_undefined(1);
+    // 4. For each Record { [[Key]], [[Value]] } entry of map.[[MapData]], do
+    //    a. If entry.[[Key]] is not empty and SameValue(entry.[[Key]], key) is true, return entry.[[Value]].
+    if let Some(existing) = map_table(agent, map).get(&key) {
+        return Ok(existing);
+    }
+    // 5. Let entry be the Record { [[Key]]: key, [[Value]]: value }.
+    // 6. Append entry to map.[[MapData]].
+    map_table(agent, map).set(key, value);
+    // 7. Return value.
+    Ok(value)
 }
