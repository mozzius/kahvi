diff --git a/crates/kahvi-builtins/src/set/prototype_add.rs b/crates/kahvi-builtins/src/set/prototype_add.rs
index bda418b..e87a701 100644
--- a/crates/kahvi-builtins/src/set/prototype_add.rs
+++ b/crates/kahvi-builtins/src/set/prototype_add.rs
@@ -2,6 +2,7 @@
 //!
 //! Spec: https://tc39.es/ecma262/#sec-set.prototype.add
 
+use crate::support::collections::{collection_key, set_table, this_set};
 use kahvi_core::prelude::*;
 
 /// Set.prototype.add
@@ -9,18 +10,21 @@ pub(crate) fn prototype_add(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _set_ be the *this* value.
-    // 2. Perform ? RequireInternalSlot(_set_, [[SetData]]).
-    // 3. Set _value_ to CanonicalizeKeyedCollectionKey(_value_).
-    // 4. For each element _entry_ of _set_.[[SetData]], do
-    //    a. If _entry_ is not ~empty~ and SameValue(_entry_, _value_) is *true*, then
-    //       i. Return _set_.
-    // 5. Append _value_ to _set_.[[SetData]].
-    // 6. Return _set_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Set.prototype.add"))
+    // 1. Let set be the this value.
+    // 2. Perform ? RequireInternalSlot(set, [[SetData]]).
+    let set = this_set(agent, this)?;
+    // 3. Set value to CanonicalizeKeyedCollectionKey(value).
+    let value = collection_key(agent, args.get_or_undefined(0));
+    // 4. For each element entry of set.[[SetData]], do
+    //    a. If entry is not ~empty~ and SameValue(entry, value) is true, then
+    //       i. Return set.
+    if set_table(agent, set).has(&value) {
+        return Ok(Value::Object(set));
+    }
+    // 5. Append value to set.[[SetData]].
+    set_table(agent, set).set(value, Value::Undefined);
+    // 6. Return set.
+    Ok(Value::Object(set))
 }
