diff --git a/crates/kahvi-builtins/src/math/log.rs b/crates/kahvi-builtins/src/math/log.rs
index 8cc2cfd..715708c 100644
--- a/crates/kahvi-builtins/src/math/log.rs
+++ b/crates/kahvi-builtins/src/math/log.rs
@@ -20,6 +20,26 @@ pub(crate) fn log(
     // 4. If _n_ is either *+0*_𝔽 or *-0*_𝔽, return *-∞*_𝔽.
     // 5. If _n_ < *-0*_𝔽, return *NaN*.
     // 6. Return an implementation-approximated Number value representing ln(ℝ(_n_)).
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Math.log"))
+    let _ = (this, new_target);
+    let x = args.get_or_undefined(0);
+    // 1. Let _n_ be ? ToNumber(_x_).
+    let n = ops::to_number(agent, x)?;
+    // 2. If _n_ is either *NaN* or *+∞*_𝔽, return _n_.
+    if n.is_nan() || n == f64::INFINITY {
+        return Ok(Value::Number(n));
+    }
+    // 3. If _n_ is *1*_𝔽, return *+0*_𝔽.
+    if n == 1.0 {
+        return Ok(Value::Number(0.0));
+    }
+    // 4. If _n_ is either *+0*_𝔽 or *-0*_𝔽, return *-∞*_𝔽.
+    if n == 0.0 {
+        return Ok(Value::Number(f64::NEG_INFINITY));
+    }
+    // 5. If _n_ < *-0*_𝔽, return *NaN*.
+    if n < 0.0 {
+        return Ok(Value::Number(f64::NAN));
+    }
+    // 6. Return an implementation-approximated Number value representing ln(ℝ(_n_)).
+    Ok(Value::Number(n.ln()))
 }
