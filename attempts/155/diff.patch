diff --git a/crates/kahvi-builtins/src/set/prototype_union.rs b/crates/kahvi-builtins/src/set/prototype_union.rs
index b3d1046..6a1059b 100644
--- a/crates/kahvi-builtins/src/set/prototype_union.rs
+++ b/crates/kahvi-builtins/src/set/prototype_union.rs
@@ -2,32 +2,121 @@
 //!
 //! Spec: https://tc39.es/ecma262/#sec-set.prototype.union
 
+use crate::support::collections::{OrderedTable, SetData, collection_key, set_table, this_set};
+use kahvi_core::object::ObjectKind;
 use kahvi_core::prelude::*;
 
+/// A Set Record (§24.2.1.2): the other object's size, has and keys methods.
+/// GetSetRecord is local to this file for now; the other Set methods need it
+/// too and can share it once it moves into `support/collections.rs`.
+#[allow(dead_code)]
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct SetRecord {
+    /// [[SetObject]]
+    pub(crate) set_object: Object,
+    /// [[Size]]
+    pub(crate) size: f64,
+    /// [[Has]]
+    pub(crate) has: Value,
+    /// [[Keys]]
+    pub(crate) keys: Value,
+}
+
+/// GetSetRecord(obj) (§24.2.1.3)
+pub(crate) fn get_set_record(agent: &mut Agent, obj: Value) -> JsResult<SetRecord> {
+    // 1. If obj is not an Object, throw a TypeError exception.
+    let Value::Object(set_object) = obj else {
+        return Err(agent.throw_type_error("argument is not an object"));
+    };
+    // 2. Let rawSize be ? Get(obj, "size").
+    let size_key = agent.key("size");
+    let raw_size = ops::get(agent, set_object, size_key)?;
+    // 3. Let numberSize be ? ToNumber(rawSize).
+    let number_size = ops::to_number(agent, raw_size)?;
+    // 4. NOTE: If rawSize is undefined, then numberSize will be NaN.
+    // 5. If numberSize is NaN, throw a TypeError exception.
+    if number_size.is_nan() {
+        return Err(agent.throw_type_error("size is not a number"));
+    }
+    // 6. Let intSize be ! ToIntegerOrInfinity(numberSize).
+    let int_size = ops::to_integer_or_infinity(agent, Value::Number(number_size))?;
+    // 7. If intSize < 0, throw a RangeError exception.
+    if int_size < 0.0 {
+        return Err(agent.throw_range_error("size must not be negative"));
+    }
+    // 8. Let has be ? Get(obj, "has").
+    let has_key = agent.key("has");
+    let has = ops::get(agent, set_object, has_key)?;
+    // 9. If IsCallable(has) is false, throw a TypeError exception.
+    if !ops::is_callable(agent, has) {
+        return Err(agent.throw_type_error("has is not a function"));
+    }
+    // 10. Let keys be ? Get(obj, "keys").
+    let keys_key = agent.key("keys");
+    let keys = ops::get(agent, set_object, keys_key)?;
+    // 11. If IsCallable(keys) is false, throw a TypeError exception.
+    if !ops::is_callable(agent, keys) {
+        return Err(agent.throw_type_error("keys is not a function"));
+    }
+    // 12. Return a new Set Record { [[SetObject]]: obj, [[Size]]: intSize, [[Has]]: has, [[Keys]]: keys }.
+    Ok(SetRecord {
+        set_object,
+        size: int_size,
+        has,
+        keys,
+    })
+}
+
 /// Set.prototype.union
 pub(crate) fn prototype_union(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _set_ be the *this* value.
-    // 2. Perform ? RequireInternalSlot(_set_, [[SetData]]).
-    // 3. Let _otherRecord_ be ? GetSetRecord(_other_).
-    // 4. Let _keysIterator_ be ? GetIteratorFromMethod(_otherRecord_.[[SetObject]], _otherRecord_.[[Keys]]).
-    // 5. Let _resultSetData_ be a copy of _set_.[[SetData]].
-    // 6. Let _next_ be ~not-started~.
-    // 7. Repeat, while _next_ is not ~done~,
-    //    a. Set _next_ to ? IteratorStepValue(_keysIterator_).
-    //    b. If _next_ is not ~done~, then
-    //       i. Set _next_ to CanonicalizeKeyedCollectionKey(_next_).
-    //       ii. If SetDataHas(_resultSetData_, _next_) is *false*, then
-    //          1. Append _next_ to _resultSetData_.
-    // 8. Let _result_ be OrdinaryObjectCreate(%Set.prototype%, « [[SetData]] »).
-    // 9. Set _result_.[[SetData]] to _resultSetData_.
-    // 10. Return _result_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Set.prototype.union"))
+    // 1. Let set be the this value.
+    // 2. Perform ? RequireInternalSlot(set, [[SetData]]).
+    let set = this_set(agent, this)?;
+    // 3. Let otherRecord be ? GetSetRecord(other).
+    let other_record = get_set_record(agent, args.get_or_undefined(0))?;
+    // 4. Let keysIterator be ? GetIteratorFromMethod(otherRecord.[[SetObject]], otherRecord.[[Keys]]).
+    let mut keys_iterator = ops::get_iterator_from_method(
+        agent,
+        Value::Object(other_record.set_object),
+        other_record.keys,
+    )?;
+    // 5. Let resultSetData be a copy of set.[[SetData]].
+    let mut result_set_data = OrderedTable::default();
+    for i in 0..set_table(agent, set).slots() {
+        if let Some((key, _)) = set_table(agent, set).entry(i) {
+            let key = collection_key(agent, key);
+            result_set_data.set(key, Value::Undefined);
+        }
+    }
+    // 6. Let next be not-started.
+    // 7. Repeat, while next is not done,
+    loop {
+        // a. Set next to ? IteratorStepValue(keysIterator).
+        let Some(next) = ops::iterator_step_value(agent, &mut keys_iterator)? else {
+            // (next is done, so the loop ends.)
+            break;
+        };
+        // b. If next is not done, then
+        //    i. Set next to CanonicalizeKeyedCollectionKey(next).
+        let key = collection_key(agent, next);
+        //    ii. If SetDataHas(resultSetData, next) is false, then
+        if !result_set_data.has(&key) {
+            //    1. Append next to resultSetData.
+            result_set_data.set(key, Value::Undefined);
+        }
+    }
+    // 8. Let result be OrdinaryObjectCreate(%Set.prototype%, « [[SetData]] »).
+    let proto = agent.intrinsic("%Set.prototype%");
+    // 9. Set result.[[SetData]] to resultSetData.
+    let result = agent.object_with_kind(
+        Some(proto),
+        ObjectKind::Native(Box::new(SetData(result_set_data))),
+    );
+    // 10. Return result.
+    Ok(Value::Object(result))
 }
