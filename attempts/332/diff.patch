 //!
 //! Spec: https://tc39.es/ecma262/#sec-%typedarray%.prototype.tosorted
 
+use kahvi_core::object::typed_array::typed_array_length;
 use kahvi_core::prelude::*;
 
+use crate::generated::array::prototype_sort::sort_indexed_properties;
+use crate::support::typed_array::{
+    typed_array_create_same_type, typed_array_set_element, validate_typed_array,
+};
+
+// Copied from `typed_array/prototype_sort.rs`, where it is private to the sort method.
+/// CompareTypedArrayElements ( _x_, _y_, _comparator_ )
+///
+/// Spec: https://tc39.es/ecma262/#sec-comparetypedarrayelements
+fn compare_typed_array_elements(
+    agent: &mut Agent,
+    x: Value,
+    y: Value,
+    comparator: Value,
+) -> JsResult<f64> {
+    // 1. Assert: _x_ is a Number and _y_ is a Number, or _x_ is a BigInt and _y_ is a BigInt.
+    // 2. If _comparator_ is not *undefined*, then
+    if !comparator.is_undefined() {
+        // a. Let _result_ be ? ToNumber(? Call(_comparator_, *undefined*, « _x_, _y_ »)).
+        // x and y are among the items SortIndexedProperties keeps rooted.
+        let v = ops::call_rooted(agent, comparator, Value::Undefined, &[x, y])?;
+        let result = ops::to_number(agent, v)?;
+        // b. If _result_ is *NaN*, return *+0*𝔽.
+        if result.is_nan() {
+            return Ok(0.0);
+        }
+        // c. Return _result_.
+        return Ok(result);
+    }
+    match (x, y) {
+        (Value::Number(x), Value::Number(y)) => {
+            // 3. If _x_ is *NaN* and _y_ is *NaN*, return *+0*𝔽.
+            if x.is_nan() && y.is_nan() {
+                return Ok(0.0);
+            }
+            // 4. If _x_ is *NaN*, return *1*𝔽.
+            if x.is_nan() {
+                return Ok(1.0);
+            }
+            // 5. If _y_ is *NaN*, return *-1*𝔽.
+            if y.is_nan() {
+                return Ok(-1.0);
+            }
+            // 6. If _x_ < _y_, return *-1*𝔽.
+            if x < y {
+                return Ok(-1.0);
+            }
+            // 7. If _x_ > _y_, return *1*𝔽.
+            if x > y {
+                return Ok(1.0);
+            }
+            // 8. If _x_ is *-0*𝔽 and _y_ is *+0*𝔽, return *-1*𝔽.
+            if x == 0.0 && y == 0.0 && x.is_sign_negative() && !y.is_sign_negative() {
+                return Ok(-1.0);
+            }
+            // 9. If _x_ is *+0*𝔽 and _y_ is *-0*𝔽, return *1*𝔽.
+            if x == 0.0 && y == 0.0 && !x.is_sign_negative() && y.is_sign_negative() {
+                return Ok(1.0);
+            }
+            // 10. Return *+0*𝔽.
+            Ok(0.0)
+        }
+        (Value::BigInt(x), Value::BigInt(y)) => {
+            // 6. If _x_ < _y_, return *-1*𝔽.
+            if ops::bigint::less_than(agent, x, y) {
+                return Ok(-1.0);
+            }
+            // 7. If _x_ > _y_, return *1*𝔽.
+            if ops::bigint::less_than(agent, y, x) {
+                return Ok(1.0);
+            }
+            // 10. Return *+0*𝔽.
+            Ok(0.0)
+        }
+        // Both values come from the same TypedArray, so the Assert in step 1 holds.
+        _ => Err(agent.throw_type_error("TypedArray elements have mismatched types")),
+    }
+}
+
 /// TypedArray.prototype.toSorted
 pub(crate) fn prototype_to_sorted(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
     // 1. If _comparator_ is not *undefined* and IsCallable(_comparator_) is *false*, throw a *TypeError* exception.
+    let comparator = args.get_or_undefined(0);
+    if !comparator.is_undefined() && !ops::is_callable(agent, comparator) {
+        return Err(agent.throw_type_error(
+            "%TypedArray%.prototype.toSorted comparator must be a function or undefined",
+        ));
+    }
     // 2. Let _obj_ be the *this* value.
+    let obj = this;
     // 3. Let _taRecord_ be ? ValidateTypedArray(_obj_, ~seq-cst~).
+    let ta_record = validate_typed_array(agent, obj)?;
+    let o = ta_record.object;
     // 4. Let _length_ be TypedArrayLength(_taRecord_).
+    let length = typed_array_length(agent, ta_record) as f64;
     // 5. Let _resultArray_ be ? TypedArrayCreateSameType(_obj_, _length_).
-    // 6. NOTE: The following closure performs a numeric comparison rather than the string comparison used in [sec-array.prototype.tosorted].
-    // 7. Let _sortCompare_ be a new Abstract Closure with parameters (_x_, _y_) that captures _comparator_ and performs the following steps when called:
-    //    a. Return ? CompareTypedArrayElements(_x_, _y_, _comparator_).
-    // 8. Let _sortedList_ be ? SortIndexedProperties(_obj_, _length_, _sortCompare_, ~read-through-holes~).
-    // 9. Let _j_ be 0.
-    // 10. Repeat, while _j_ < _length_,
-    //    a. Perform ! TypedArraySetElement(_resultArray_, 𝔽(_j_), _sortedList_[_j_]).
-    //    b. Set _j_ to _j_ + 1.
-    // 11. Return _resultArray_.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("TypedArray.prototype.toSorted"))
+    let result_array = typed_array_create_same_type(agent, o, length)?;
+    // The comparator may collect garbage: obj, the comparator and the result stay rooted
+    // (SortIndexedProperties roots the items).
+    agent.with_roots(
+        &[comparator, Value::Object(o), Value::Object(result_array)],
+        |agent| {
+            // 6. NOTE: The following closure performs a numeric comparison rather than the string comparison used in [sec-array.prototype.tosorted].
+            // 7. Let _sortCompare_ be a new Abstract Closure with parameters (_x_, _y_) that captures _comparator_ and performs the following steps when called:
+            //    a. Return ? CompareTypedArrayElements(_x_, _y_, _comparator_).
+            let mut sort_compare = |agent: &mut Agent, x: Value, y: Value| {
+                compare_typed_array_elements(agent, x, y, comparator)
+            };
+            // 8. Let _sortedList_ be ? SortIndexedProperties(_obj_, _length_, _sortCompare_, ~read-through-holes~).
+            let sorted_list = sort_indexed_properties(agent, o, length, &mut sort_compare, false)?;
+            // 9. Let _j_ be 0.
+            let mut j = 0.0;
+            // 10. Repeat, while _j_ < _length_,
+            for item in sorted_list {
+                // a. Perform ! TypedArraySetElement(_resultArray_, 𝔽(_j_), _sortedList_[_j_]).
+                typed_array_set_element(agent, result_array, j, item)?;
+                // b. Set _j_ to _j_ + 1.
+                j += 1.0;
+            }
+            // 11. Return _resultArray_.
+            Ok(Value::Object(result_array))
+        },
+    )
 }
