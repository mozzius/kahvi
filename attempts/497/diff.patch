+
+/// SetterThatIgnoresPrototypeProperties ( thisValue, home, p, v )
+fn setter_that_ignores_prototype_properties(
+    agent: &mut Agent,
+    this_value: Value,
+    home: Object,
+    property_key: PropertyKey,
+    value: Value,
+) -> JsResult<()> {
+    // 1. If _thisValue_ is not an Object, then
+    let Value::Object(this_obj) = this_value else {
+        // a. Throw a *TypeError* exception.
+        return Err(agent.throw_type_error("setter called on non-object"));
+    };
+    // 2. If SameValue(_thisValue_, _home_) is *true*, then
+    if ops::same_value(agent, this_value, Value::Object(home)) {
+        // a. NOTE: Throwing here emulates assignment to a non-writable data property on the _home_ object in strict mode code.
+        // b. Throw a *TypeError* exception.
+        return Err(agent.throw_type_error("cannot assign to Iterator.prototype property"));
+    }
+    // 3. Let _propertyDesc_ be ? _thisValue_.[[GetOwnProperty]](_propertyKey_).
+    let property_desc = this_obj.internal_get_own_property(agent, property_key)?;
+    // 4. If _propertyDesc_ is *undefined*, then
+    if property_desc.is_none() {
+        // a. Perform ? CreateDataPropertyOrThrow(_thisValue_, _propertyKey_, _value_).
+        ops::create_data_property_or_throw(agent, this_obj, property_key, value)?;
+    } else {
+        // 5. Else,
+        // a. Perform ? Set(_thisValue_, _propertyKey_, _value_, *true*).
+        ops::set(agent, this_obj, property_key, value, true)?;
+    }
+    // 6. Return ~unused~.
+    Ok(())
 }
