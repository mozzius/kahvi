diff --git a/crates/kahvi-builtins/src/typed_array/prototype_reduce.rs b/crates/kahvi-builtins/src/typed_array/prototype_reduce.rs
index 5a01ebb..dd8808e 100644
--- a/crates/kahvi-builtins/src/typed_array/prototype_reduce.rs
+++ b/crates/kahvi-builtins/src/typed_array/prototype_reduce.rs
@@ -4,35 +4,74 @@
 
 use kahvi_core::prelude::*;
 
+use crate::support::typed_array::{length, typed_array_get_element, validate_typed_array};
+
 /// TypedArray.prototype.reduce
 pub(crate) fn prototype_reduce(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
     // The interpretation and use of the arguments of this method are the same as for `Array.prototype.reduce` as defined in [sec-array.prototype.reduce].
     // This method performs the following steps when called:
     //
     // 1. Let _obj_ be the *this* value.
+    let Value::Object(obj) = this else {
+        return Err(agent.throw_type_error("not a TypedArray"));
+    };
     // 2. Let _taRecord_ be ? ValidateTypedArray(_obj_, ~seq-cst~).
+    let ta_record = validate_typed_array(agent, this)?;
     // 3. Let _length_ be TypedArrayLength(_taRecord_).
+    let len = length(agent, ta_record) as f64;
     // 4. If IsCallable(_callback_) is *false*, throw a *TypeError* exception.
+    let callback = args.get_or_undefined(0);
+    if !ops::is_callable(agent, callback) {
+        return Err(
+            agent.throw_type_error("TypedArray.prototype.reduce callback is not a function")
+        );
+    }
     // 5. If _length_ = 0 and _initialValue_ is not present, throw a *TypeError* exception.
+    let initial_value_present = args.len() >= 2;
+    if len == 0.0 && !initial_value_present {
+        return Err(agent
+            .throw_type_error("TypedArray.prototype.reduce of empty array with no initial value"));
+    }
     // 6. Let _k_ be 0.
+    let mut k = 0.0;
     // 7. Let _accumulator_ be *undefined*.
+    let mut accumulator = Value::Undefined;
     // 8. If _initialValue_ is present, then
-    //    a. Set _accumulator_ to _initialValue_.
-    // 9. Else,
-    //    a. Set _accumulator_ to TypedArrayGetElement(_obj_, 𝔽(_k_)).
-    //    b. Set _k_ to _k_ + 1.
-    // 10. Repeat, while _k_ < _length_,
-    //    a. Let _kValue_ be TypedArrayGetElement(_obj_, 𝔽(_k_)).
-    //    b. Set _accumulator_ to ? Call(_callback_, *undefined*, « _accumulator_, _kValue_, 𝔽(_k_), _obj_ »).
-    //    c. Set _k_ to _k_ + 1.
-    // 11. Return _accumulator_.
-    //
-    // This method is not generic. The *this* value must be an object with a [[TypedArrayName]] internal slot.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("TypedArray.prototype.reduce"))
+    if initial_value_present {
+        // a. Set _accumulator_ to _initialValue_.
+        accumulator = args.get_or_undefined(1).clone();
+    } else {
+        // 9. Else,
+        // a. Set _accumulator_ to TypedArrayGetElement(_obj_, 𝔽(_k_)).
+        accumulator = typed_array_get_element(agent, obj, k);
+        // b. Set _k_ to _k_ + 1.
+        k += 1.0;
+    }
+    // The callback may collect garbage: what is used after it stays rooted.
+    agent.with_roots(&[Value::Object(obj), callback], |agent| {
+        // 10. Repeat, while _k_ < _length_,
+        while k < len {
+            // a. Let _kValue_ be TypedArrayGetElement(_obj_, 𝔽(_k_)).
+            let k_value = typed_array_get_element(agent, obj, k);
+            // b. Set _accumulator_ to ? Call(_callback_, *undefined*, « _accumulator_, _kValue_, 𝔽(_k_), _obj_ »).
+            let mark = agent.push_root(accumulator);
+            agent.push_root(k_value);
+            accumulator = ops::call_rooted(
+                agent,
+                callback,
+                Value::Undefined,
+                &[accumulator, k_value, Value::Number(k), Value::Object(obj)],
+            )?;
+            agent.pop_roots(mark);
+            // c. Set _k_ to _k_ + 1.
+            k += 1.0;
+        }
+        // 11. Return _accumulator_.
+        Ok(accumulator)
+    })
 }
