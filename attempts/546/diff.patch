+/// The calendars ICU4X can format with, the locale default first.
+const CALENDARS: &[&str] = &[
+    "gregory",
+    "buddhist",
+    "chinese",
+    "coptic",
+    "dangi",
+    "ethioaa",
+    "ethiopic",
+    "hebrew",
+    "indian",
+    "islamic",
+    "islamic-civil",
+    "islamic-tbla",
+    "islamic-umalqura",
+    "iso8601",
+    "japanese",
+    "persian",
+    "roc",
+];
+
+const HOUR_CYCLES: &[&str] = &["h11", "h12", "h23", "h24"];
+
+/// The hour cycle ICU4X's pattern for the locale's short time uses: h12 when
+/// midnight is printed as 12, otherwise h23.
+fn locale_hour_cycle(locale: &str) -> &'static str {
+    let probe = || -> Option<String> {
+        let locale: Locale = locale.parse().ok()?;
+        let formatter =
+            NoCalendarFormatter::try_new((&locale).into(), fieldsets::T::short()).ok()?;
+        let midnight = Time::try_new(0, 30, 0, 0).ok()?;
+        Some(formatter.format(&midnight).to_string())
+    };
+    match probe() {
+        Some(s) if s.trim_start().starts_with("12") => "h12",
+        _ => "h23",
+    }
+}
+
+/// %Intl.DateTimeFormat%.[[LocaleData]]: for a locale and relevant extension
+/// key, the supported values with the default first.
+fn locale_data(locale: &str, key: &str) -> Vec<Option<String>> {
+    match key {
+        "ca" => CALENDARS.iter().map(|c| Some(c.to_string())).collect(),
+        "nu" => vec![Some("latn".to_string())],
+        "hc" => {
+            let default = locale_hour_cycle(locale);
+            std::iter::once(default)
+                .chain(HOUR_CYCLES.iter().copied().filter(|h| *h != default))
+                .map(|h| Some(h.to_string()))
+                .collect()
+        }
+        _ => Vec::new(),
+    }
+}
