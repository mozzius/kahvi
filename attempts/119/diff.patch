+                callback,
+                Value::Undefined,
+                &[
+                    accumulator,
+                    k_value,
+                    Value::Number(k as f64),
+                    Value::Object(obj),
+                ],
+            )?;
+            agent.pop_roots(mark);
+            // c. Set _k_ to _k_ + 1.
+            k += 1;
+        }
+        // 11. Return _accumulator_.
+        Ok(accumulator)
+    })
