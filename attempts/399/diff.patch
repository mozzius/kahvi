 //!
 //! Spec: https://tc39.es/ecma262/#sec-date.prototype.getmonth
 
+use crate::support::date;
 use kahvi_core::prelude::*;
 
 /// Date.prototype.getMonth
 pub(crate) fn prototype_get_month(
     agent: &mut Agent,
     this: Value,
-    args: &[Value],
-    new_target: Option<Object>,
+    _args: &[Value],
