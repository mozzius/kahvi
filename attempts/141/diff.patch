 //!
 //! Spec: https://tc39.es/ecma262/#sec-%typedarray%.prototype.sort
 
+use kahvi_core::object::typed_array::typed_array_length;
 use kahvi_core::prelude::*;
 
+use crate::generated::array::prototype_sort::sort_indexed_properties;
+use crate::support::typed_array::{typed_array_set_element, validate_typed_array};
+
+/// CompareTypedArrayElements ( _x_, _y_, _comparator_ )
+///
+/// Spec: https://tc39.es/ecma262/#sec-comparetypedarrayelements
+fn compare_typed_array_elements(
+    agent: &mut Agent,
+    x: Value,
+    y: Value,
+    comparator: Value,
+) -> JsResult<f64> {
+    // 1. Assert: _x_ is a Number and _y_ is a Number, or _x_ is a BigInt and _y_ is a BigInt.
+    // 2. If _comparator_ is not *undefined*, then
+    if !matches!(comparator, Value::Undefined) {
+        // a. Let _result_ be ? ToNumber(? Call(_comparator_, *undefined*, « _x_, _y_ »)).
+        // x and y are among the items SortIndexedProperties keeps rooted.
+        let v = ops::call_rooted(agent, comparator, Value::Undefined, &[x, y])?;
+        let result = ops::to_number(agent, v)?;
+        // b. If _result_ is *NaN*, return *+0*𝔽.
+        if result.is_nan() {
+            return Ok(0.0);
+        }
+        // c. Return _result_.
+        return Ok(result);
+    }
+    match (x, y) {
+        (Value::Number(x), Value::Number(y)) => {
+            // 3. If _x_ is *NaN* and _y_ is *NaN*, return *+0*𝔽.
+            if x.is_nan() && y.is_nan() {
+                return Ok(0.0);
+            }
+            // 4. If _x_ is *NaN*, return *1*𝔽.
+            if x.is_nan() {
+                return Ok(1.0);
+            }
+            // 5. If _y_ is *NaN*, return *-1*𝔽.
+            if y.is_nan() {
+                return Ok(-1.0);
+            }
+            // 6. If _x_ < _y_, return *-1*𝔽.
+            if x < y {
+                return Ok(-1.0);
+            }
+            // 7. If _x_ > _y_, return *1*𝔽.
+            if x > y {
+                return Ok(1.0);
+            }
+            // 8. If _x_ is *-0*𝔽 and _y_ is *+0*𝔽, return *-1*𝔽.
+            if x == 0.0 && y == 0.0 && x.is_sign_negative() && !y.is_sign_negative() {
+                return Ok(-1.0);
+            }
+            // 9. If _x_ is *+0*𝔽 and _y_ is *-0*𝔽, return *1*𝔽.
+            if x == 0.0 && y == 0.0 && !x.is_sign_negative() && y.is_sign_negative() {
+                return Ok(1.0);
+            }
+            // 10. Return *+0*𝔽.
+            Ok(0.0)
+        }
+        (Value::BigInt(x), Value::BigInt(y)) => {
+            // 6. If _x_ < _y_, return *-1*𝔽.
+            if ops::bigint::less_than(agent, x, y) {
+                return Ok(-1.0);
+            }
+            // 7. If _x_ > _y_, return *1*𝔽.
+            if ops::bigint::less_than(agent, y, x) {
+                return Ok(1.0);
+            }
+            // 10. Return *+0*𝔽.
+            Ok(0.0)
+        }
+        // Both values come from the same TypedArray, so the Assert in step 1 holds.
+        _ => Err(agent.throw_type_error("TypedArray elements have mismatched types")),
+    }
+}
+
 /// TypedArray.prototype.sort
 pub(crate) fn prototype_sort(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
     // This is a distinct method that, except as described below, implements the same requirements as those of `Array.prototype.sort` as defined in [sec-array.prototype.sort]. The implementation of this method may be optimized with the knowledge that the *this* value is an object that has a fixed length and whose integer-indexed properties are not sparse.
     // This method is not generic. The *this* value must be an object with a [[TypedArrayName]] internal slot.
     // It performs the following steps when called:
     //
     // 1. If _comparator_ is not *undefined* and IsCallable(_comparator_) is *false*, throw a *TypeError* exception.
+    let comparator = args.get_or_undefined(0);
+    if !matches!(comparator, Value::Undefined) && !ops::is_callable(agent, comparator) {
+        return Err(agent.throw_type_error(
+            "%TypedArray%.prototype.sort comparator must be a function or undefined",
+        ));
+    }
     // 2. Let _obj_ be the *this* value.
+    let obj = this;
     // 3. Let _taRecord_ be ? ValidateTypedArray(_obj_, ~seq-cst~).
+    let ta_record = validate_typed_array(agent, obj)?;
+    let Value::Object(obj) = obj else {
+        unreachable!("ValidateTypedArray accepted a non-object")
+    };
     // 4. Let _length_ be TypedArrayLength(_taRecord_).
+    let length = typed_array_length(agent, ta_record) as f64;
     // 5. NOTE: The following closure performs a numeric comparison rather than the string comparison used in [sec-array.prototype.sort].
     // 6. Let _sortCompare_ be a new Abstract Closure with parameters (_x_, _y_) that captures _comparator_ and performs the following steps when called:
     //    a. Return ? CompareTypedArrayElements(_x_, _y_, _comparator_).
-    // 7. Let _sortedList_ be ? SortIndexedProperties(_obj_, _length_, _sortCompare_, ~read-through-holes~).
-    // 8. Let _j_ be 0.
-    // 9. Repeat, while _j_ < _length_,
-    //    a. Perform ! TypedArraySetElement(_obj_, 𝔽(_j_), _sortedList_[_j_]).
-    //    b. Set _j_ to _j_ + 1.
-    // 10. Return _obj_.
-    //
-    // NOTE:
-    // Because *NaN* always compares greater than any other value (see CompareTypedArrayElements), *NaN* property values always sort to the end of the result when _comparator_ is not provided.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("TypedArray.prototype.sort"))
+    let mut sort_compare = |agent: &mut Agent, x: Value, y: Value| {
+        compare_typed_array_elements(agent, x, y, comparator)
+    };
+    // The comparator may collect garbage: obj and the comparator stay rooted
+    // (SortIndexedProperties roots the items).
+    agent.with_roots(&[Value::Object(obj), comparator], |agent| {
+        // 7. Let _sortedList_ be ? SortIndexedProperties(_obj_, _length_, _sortCompare_, ~read-through-holes~).
+        let sorted_list = sort_indexed_properties(agent, obj, length, &mut sort_compare, false)?;
+        // 8. Let _j_ be 0.
+        let mut j = 0.0;
+        // 9. Repeat, while _j_ < _length_,
+        for item in sorted_list {
+            // a. Perform ! TypedArraySetElement(_obj_, 𝔽(_j_), _sortedList_[_j_]).
+            typed_array_set_element(agent, obj, j, item)?;
+            // b. Set _j_ to _j_ + 1.
+            j += 1.0;
+        }
+        // 10. Return _obj_.
+        Ok(Value::Object(obj))
+    })
 }
