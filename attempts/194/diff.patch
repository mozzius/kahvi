 use kahvi_core::prelude::*;
 
+const MAX_SAFE_INTEGER: f64 = 9_007_199_254_740_991.0;
+
 /// Array.prototype.flatMap
 pub(crate) fn prototype_flat_map(
     agent: &mut Agent,
     this: Value,
     args: &[Value],
-    new_target: Option<Object>,
