 //!
 //! Spec: https://tc39.es/ecma262/#sec-date.prototype.todatestring
 
+use crate::support::date;
 use kahvi_core::prelude::*;
 
 /// Date.prototype.toDateString
 pub(crate) fn prototype_to_date_string(
     agent: &mut Agent,
     this: Value,
-    args: &[Value],
-    new_target: Option<Object>,
+    _args: &[Value],
+    _new_target: Option<Object>,
 ) -> JsResult<Value> {
-    // This method performs the following steps when called:
-    //
-    // 1. Let _dateObj_ be the *this* value.
-    // 2. Perform ? RequireInternalSlot(_dateObj_, [[DateValue]]).
-    // 3. Let _tv_ be _dateObj_.[[DateValue]].
-    // 4. If _tv_ is *NaN*, return *"Invalid Date"*.
-    // 5. Let _t_ be LocalTime(_tv_).
-    // 6. Return DateString(_t_).
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("Date.prototype.toDateString"))
+    // 1-2. Let dateObj be the this value, and perform ? RequireInternalSlot(dateObj, [[DateValue]]).
+    // 3. Let tv be dateObj.[[DateValue]].
+    let tv = date::this_time_value(agent, this)?;
+    // 4. If tv is NaN, return "Invalid Date".
+    if tv.is_nan() {
+        return Ok(Value::String(agent.string("Invalid Date")));
+    }
+    // 5. Let t be LocalTime(tv).
+    let t = date::local_time(agent, tv);
+    // 6. Return DateString(t).
+    let s = date::date_string(t);
+    Ok(Value::String(agent.string(&s)))
 }
