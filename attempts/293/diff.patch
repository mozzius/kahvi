diff --git a/crates/kahvi-builtins/src/typed_array/prototype_reduce_right.rs b/crates/kahvi-builtins/src/typed_array/prototype_reduce_right.rs
index a8f83c6..36aee72 100644
--- a/crates/kahvi-builtins/src/typed_array/prototype_reduce_right.rs
+++ b/crates/kahvi-builtins/src/typed_array/prototype_reduce_right.rs
@@ -4,6 +4,10 @@
 
 use kahvi_core::prelude::*;
 
+use crate::support::typed_array::{
+    length as typed_array_length, typed_array_get_element, validate_typed_array,
+};
+
 /// TypedArray.prototype.reduceRight
 pub(crate) fn prototype_reduce_right(
     agent: &mut Agent,
@@ -33,6 +37,58 @@ pub(crate) fn prototype_reduce_right(
     // 11. Return _accumulator_.
     //
     // This method is not generic. The *this* value must be an object with a [[TypedArrayName]] internal slot.
-    let _ = (this, args, new_target);
-    Err(agent.not_implemented("TypedArray.prototype.reduceRight"))
+    let _ = new_target;
+    // 1. Let _obj_ be the *this* value.
+    let obj = this;
+    // 2. Let _taRecord_ be ? ValidateTypedArray(_obj_, ~seq-cst~).
+    let ta_record = validate_typed_array(agent, obj)?;
+    // 3. Let _length_ be TypedArrayLength(_taRecord_).
+    let len = typed_array_length(agent, ta_record) as f64;
+    let o = ta_record.object;
+    let callback = args.get_or_undefined(0);
+    // 4. If IsCallable(_callback_) is *false*, throw a *TypeError* exception.
+    if !ops::is_callable(agent, callback) {
+        return Err(
+            agent.throw_type_error("TypedArray.prototype.reduceRight callback is not a function")
+        );
+    }
+    // 5. If _length_ = 0 and _initialValue_ is not present, throw a *TypeError* exception.
+    if len == 0.0 && args.len() < 2 {
+        return Err(agent.throw_type_error("reduce of empty TypedArray with no initial value"));
+    }
+    // The callback may collect garbage: O and callback stay rooted.
+    agent.with_roots(&[Value::Object(o), callback], |agent| {
+        // 6. Let _k_ be _length_ - 1.
+        let mut k = len - 1.0;
+        // 7. Let _accumulator_ be *undefined*.
+        let mut accumulator;
+        // 8. If _initialValue_ is present, then
+        if args.len() >= 2 {
+            // a. Set _accumulator_ to _initialValue_.
+            accumulator = args.get_or_undefined(1);
+        } else {
+            // 9. Else,
+            // a. Set _accumulator_ to TypedArrayGetElement(_obj_, 𝔽(_k_)).
+            accumulator = typed_array_get_element(agent, o, k);
+            // b. Set _k_ to _k_ - 1.
+            k -= 1.0;
+        }
+        // 10. Repeat, while _k_ ≥ 0,
+        while k >= 0.0 {
+            // a. Let _kValue_ be TypedArrayGetElement(_obj_, 𝔽(_k_)).
+            let acc = accumulator;
+            let k_value = agent.with_roots(&[acc], |agent| typed_array_get_element(agent, o, k));
+            // b. Set _accumulator_ to ? Call(_callback_, *undefined*, « _accumulator_, _kValue_, 𝔽(_k_), _obj_ »).
+            accumulator = ops::call_rooted(
+                agent,
+                callback,
+                Value::Undefined,
+                &[acc, k_value, Value::Number(k), Value::Object(o)],
+            )?;
+            // c. Set _k_ to _k_ - 1.
+            k -= 1.0;
+        }
+        // 11. Return _accumulator_.
+        Ok(accumulator)
+    })
 }
